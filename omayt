def format_tui_rows(videos: list[dict[str, Any]], header_note: str = "") -> str:
    """
    Formata as linhas para o fzf.
    Coluna 1 (oculta com --with-nth=2..): ID do vídeo ou comando especial
    Coluna 2 (visível): Linha estilizada com as cores do tema do Omarchy
    """
    c_acc = THEME.ansi_fg("accent", bold=True)
    c_fg = THEME.ansi_fg("foreground")
    c_yel = THEME.ansi_fg("yellow", bold=True)
    c_grn = THEME.ansi_fg("green")
    c_mag = THEME.ansi_fg("magenta")
    c_mut = THEME.ansi_fg("muted")
    c_cyn = THEME.ansi_fg("cyan", bold=True)
    rst = THEME.reset

    lines: list[str] = []

    search_hint = (
        f" ({header_note})" if header_note else " (Digite acima e aperte Enter ou Ctrl+S)"
    )
    lines.append(
        f"__SEARCH__\t{c_cyn}  [Pesquisar no YouTube o texto digitado acima]{rst}{c_mut}{search_hint}{rst}"
    )

    for idx, v in enumerate(videos, 1):
        vid = v.get("id", "")
        title = v.get("title", "Sem título")
        if len(title) > 52:
            title = title[:49] + "..."
        channel = v.get("channel", "YouTube")
        if len(channel) > 18:
            channel = channel[:16] + ".."
        dur = v.get("duration", "??:??")
        views = v.get("views", "—")

        row = (
            f"{vid}\t"
            f"{c_mut}{idx:02d}.{rst} "
            f"{c_fg}{title:<52}{rst} "
            f"{c_yel}[{dur:>7}]{rst} "
            f"{c_grn}󰠃 {channel:<18}{rst} "
            f"{c_mag}󰈈 {views:>6}{rst}"
        )
        lines.append(row)

    if not videos:
        lines.append(
            f"__HISTORY__\t{c_acc}󰋚  [Nenhum vídeo carregado — digite sua pesquisa acima e aperte Enter ou Ctrl+S]{rst}"
        )

    return "\n".join(lines)


