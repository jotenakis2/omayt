class OmarchyTheme:
    """Automatically reads the color palette of the active Omarchy theme."""

    def __init__(self) -> None:
        self.name = "Omarchy"
        self.colors = dict(DEFAULT_COLORS)
        self._load()

    def _load(self) -> None:
        state_dir = Path.home() / ".local" / "state" / "omarchy" / "current"
        name_file = state_dir / "theme.name"
        colors_file = state_dir / "theme" / "colors.toml"

        if name_file.is_file():
            try:
                raw = name_file.read_text(encoding="utf-8").strip()
                if raw:
                    self.name = raw.replace("-", " ").title()
            except OSError:
                pass

        if not colors_file.is_file():
            fallback = Path("/usr/share/omarchy/themes/catppuccin/colors.toml")
            if fallback.is_file():
                colors_file = fallback

        if colors_file.is_file():
            try:
                for line in colors_file.read_text(encoding="utf-8").splitlines():
                    line = line.strip()
                    if not line or line.startswith("#") or "=" not in line:
                        continue
                    k, v = line.split("=", 1)
                    k = k.strip()
                    v = v.strip().strip('"').strip("'")
                    if v.startswith("#") and len(v) == 7:
                        self.colors[k] = v
            except OSError:
                pass

    def hex(self, key: str) -> str:
        return self.colors.get(key, DEFAULT_COLORS.get(key, "#cdd6f4"))

    def rgb(self, key: str) -> tuple[int, int, int]:
        h = self.hex(key).lstrip("#")
        try:
            return (int(h[0:2], 16), int(h[2:4], 16), int(h[4:6], 16))
        except ValueError:
            return (137, 180, 250)

    def ansi_fg(self, key: str, bold: bool = False) -> str:
        r, g, b = self.rgb(key)
        prefix = "\033[1;" if bold else "\033["
        return f"{prefix}38;2;{r};{g};{b}m"

    def ansi_bg(self, key: str) -> str:
        r, g, b = self.rgb(key)
        return f"\033[48;2;{r};{g};{b}m"

    @staticmethod
    def ansi_rgb(r: int, g: int, b: int, bold: bool = False) -> str:
        prefix = "\033[1;" if bold else "\033["
        return f"{prefix}38;2;{r};{g};{b}m"

    @staticmethod
    def ansi_rgb_bg(r: int, g: int, b: int) -> str:
        return f"\033[48;2;{r};{g};{b}m"

    @staticmethod
    def blend_rgb(
        c1: tuple[int, int, int], c2: tuple[int, int, int], t: float
    ) -> tuple[int, int, int]:
        t = max(0.0, min(1.0, t))
        return (
            int(c1[0] + (c2[0] - c1[0]) * t),
            int(c1[1] + (c2[1] - c1[1]) * t),
            int(c1[2] + (c2[2] - c1[2]) * t),
        )

    @property
    def reset(self) -> str:
        return "\033[0m"

    def build_gradient(self, steps: int) -> list[str]:
        """Generates a smooth vertical color gradient based on the current Omarchy theme."""
        stops = [
            self.rgb("cyan"),
            self.rgb("blue"),
            self.rgb("accent"),
            self.rgb("magenta"),
            self.rgb("yellow"),
            self.rgb("red"),
        ]
        if steps <= 1:
            r, g, b = stops[0]
            return [self.ansi_rgb(r, g, b, bold=True)]

        gradient: list[str] = []
        n_seg = len(stops) - 1
        for i in range(steps):
            t = i / (steps - 1)
            seg_f = t * n_seg
            seg_idx = min(int(seg_f), n_seg - 1)
            local_t = seg_f - seg_idx
            r1, g1, b1 = stops[seg_idx]
            r2, g2, b2 = stops[seg_idx + 1]
            r = int(r1 + (r2 - r1) * local_t)
            g = int(g1 + (g2 - g1) * local_t)
            b = int(b1 + (b2 - b1) * local_t)
            gradient.append(self.ansi_rgb(r, g, b, bold=(t > 0.75)))
        return gradient

    def fzf_color_arg(self) -> str:
        c = self.colors
        parts = [
            f"bg:{c['background']}",
            f"bg+:{c['lighter_background']}",
            f"preview-bg:{c['dark_background']}",
            f"fg:{c['foreground']}",
            f"fg+:{c['bright_foreground']}",
            f"hl:{c['accent']}",
            f"hl+:{c['yellow']}",
            f"info:{c['cyan']}",
            f"prompt:{c['accent']}",
            f"pointer:{c['red']}",
            f"marker:{c['green']}",
            f"spinner:{c['magenta']}",
            f"header:{c['light_foreground']}",
            f"border:{c['accent']}",
            f"preview-border:{c['muted']}",
            f"label:{c['accent']}",
            f"preview-label:{c['cyan']}",
            f"gutter:{c['background']}",
        ]
        return "--color=" + ",".join(parts)


