def format_duration(seconds: Any) -> str:
    if not seconds:
        return "AO VIVO"
    if isinstance(seconds, str):
        return seconds
    try:
        sec = int(float(seconds))
    except (ValueError, TypeError):
        return "??:??"
    h, rem = divmod(sec, 3600)
    m, s = divmod(rem, 60)
    if h > 0:
        return f"{h}:{m:02d}:{s:02d}"
    return f"{m:02d}:{s:02d}"


def format_views(count: Any) -> str:
    if count is None or count == "":
        return "—"
    try:
        n = int(count)
    except (ValueError, TypeError):
        return str(count)
    if n >= 1_000_000_000:
        return f"{n / 1_000_000_000:.1f}B"
    if n >= 1_000_000:
        return f"{n / 1_000_000:.1f}M"
    if n >= 1_000:
        return f"{n / 1_000:.1f}K"
    return f"{n:,}".replace(",", ".")


def search_youtube(query: str, max_results: int = 20) -> list[dict[str, Any]]:
    ensure_dirs()
    query = query.strip()
    if not query:
        return []

    record_search_history(query)
    entries_raw: list[dict[str, Any]] = []

    try:
        import yt_dlp  # type: ignore

        ydl_opts = {
            "extract_flat": "in_playlist",
            "skip_download": True,
            "quiet": True,
            "no_warnings": True,
            "extractor_args": EXTRACTOR_ARGS_DICT,
        }
        with yt_dlp.YoutubeDL(ydl_opts) as ydl:
            info = ydl.extract_info(f"ytsearch{max_results}:{query}", download=False)
            if isinstance(info, dict):
                entries_raw = info.get("entries") or []
    except Exception:
        proc = subprocess.run(
            [
                YTDLP_BIN,
                "--extractor-args",
                EXTRACTOR_ARGS_CLI,
                "--flat-playlist",
                "-J",
                "--no-warnings",
                f"ytsearch{max_results}:{query}",
            ],
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            text=True,
        )
        if proc.returncode == 0 and proc.stdout:
            try:
                info = json.loads(proc.stdout)
                entries_raw = info.get("entries") or []
            except Exception:
                entries_raw = []

    results: list[dict[str, Any]] = []
    db = load_json_file(VIDEOS_DB_FILE, {})

    for item in entries_raw:
        if not isinstance(item, dict):
            continue
        vid = item.get("id") or ""
        if not vid or len(vid) != 11:
            continue

        title = (item.get("title") or "Sem título").replace("\t", " ").replace("\n", " ").strip()
        channel = (
            item.get("channel")
            or item.get("uploader")
            or item.get("channel_id")
            or "YouTube"
        ).replace("\t", " ").strip()
        duration = format_duration(item.get("duration") or item.get("duration_string"))
        views_raw = item.get("view_count")
        views_fmt = format_views(views_raw)
        url = item.get("url") or f"https://www.youtube.com/watch?v={vid}"
        if not url.startswith("http"):
            url = f"https://www.youtube.com/watch?v={vid}"

        thumbs = item.get("thumbnails") or []
        thumb_url = f"https://i.ytimg.com/vi/{vid}/maxresdefault.jpg"
        if isinstance(thumbs, list) and thumbs:
            last_t = thumbs[-1]
            if isinstance(last_t, dict) and last_t.get("url"):
                thumb_url = last_t["url"]

        desc = item.get("description") or ""
        video_obj = {
            "id": vid,
            "title": title,
            "channel": channel,
            "duration": duration,
            "views": views_fmt,
            "views_raw": views_raw,
            "url": url,
            "thumb_url": thumb_url,
            "description": desc,
            "query": query,
            "timestamp": time.strftime("%d/%m/%Y %H:%M"),
        }
        results.append(video_obj)
        db[vid] = video_obj

    save_json_file(VIDEOS_DB_FILE, db)
    save_json_file(LAST_LIST_FILE, results)
    save_json_file(STATE_FILE, {"mode": "search", "query": query, "count": len(results)})

    first_ids = [r["id"] for r in results[:2]]
    with concurrent.futures.ThreadPoolExecutor(max_workers=2) as pool:
        pool.map(download_single_thumb, first_ids)
    prefetch_thumbnails_async([r["id"] for r in results[2:]])

    return results


