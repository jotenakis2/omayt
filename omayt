        if show_recent_bar:
            recent_chunks: list[str] = []
            used_w = 14
            for q in search_hist[:4]:
                sq = truncate_plain(q, 18)
                piece = f"{c_txt}{sq}{rst}"
                if used_w + visible_len(piece) + 4 > card_total_w:
                    break
                recent_chunks.append(piece)
                used_w += visible_len(piece) + 4
            if recent_chunks:
                rec_line = f"{c_mut}󰋚 Recentes:{rst}  " + f"  {c_mut}•{rst}  ".join(recent_chunks)
                r_pad = " " * max(0, (cols - visible_len(rec_line)) // 2)
                lines_buf.append(f"{r_pad}{rec_line}")

        # 6. Legenda de atalhos
        legend = (
            f"{c_yel}[↑/↓ j/k]{rst} {c_mut}Navegar{rst}   "
            f"{c_yel}[Enter]{rst} {c_mut}Abrir{rst}   "
            f"{c_yel}[/]{rst} {c_mut}Buscar{rst}   "
            f"{c_yel}[1-7]{rst} {c_mut}Atalho{rst}   "
            f"{c_red}[q/Esc]{rst} {c_mut}Sair{rst}"
        )
        if visible_len(legend) > cols - 2:
            legend = (
                f"{c_yel}[↑/↓]{rst} Navegar  {c_yel}[Enter]{rst} Abrir  "
                f"{c_yel}[/]{rst} Buscar  {c_red}[q]{rst} Sair"
            )
        leg_pad = " " * max(0, (cols - visible_len(legend)) // 2)
        lines_buf.append("")
        lines_buf.append(f"{leg_pad}{legend}")

        # Centralização vertical suave
        top_pad = max(0, (rows - len(lines_buf)) // 2)
        out: list[str] = ["\033[?2026h\033[H"]
        for _ in range(top_pad):
            out.append("\033[K")
        for ln in lines_buf:
            out.append(f"{ln}\033[K")
        out.append("\033[J\033[?2026l")

        sys.stdout.write("\n".join(out))
        sys.stdout.flush()

    def _prompt_search(self, music_mode: bool = False) -> str | None:
        """Modal estilizado de busca no YouTube com sugestões do histórico de pesquisas."""
        assert self.tty_fd is not None
        query = ""
        recent = load_json_file(SEARCH_HIST_FILE, [])[:6]
        hist_idx = -1  # -1 = digitando no campo de busca

        while True:
            term = shutil.get_terminal_size((100, 32))
            cols, rows = max(54, term.columns), max(16, term.lines)
            card_w = max(52, min(cols - 4, 72))
            inner_w = card_w - 4
            lm = " " * max(0, (cols - card_w) // 2)

            c_acc = THEME.ansi_fg("accent", bold=True)
            c_cyn = THEME.ansi_fg("cyan", bold=True)
            c_mag = THEME.ansi_fg("magenta", bold=True)
            c_fg = THEME.ansi_fg("bright_foreground", bold=True)
            c_txt = THEME.ansi_fg("light_foreground")
            c_yel = THEME.ansi_fg("yellow", bold=True)
            c_mut = THEME.ansi_fg("muted")
            c_red = THEME.ansi_fg("red", bold=True)
            rst = THEME.reset
            b_col = THEME.ansi_fg("magenta" if music_mode else "cyan")
            dim_b = THEME.ansi_fg("muted")
            sel_bg = THEME.ansi_rgb_bg(*THEME.blend_rgb(THEME.rgb("lighter_background"), THEME.rgb("accent"), 0.16))

            title_l = (
                f"{c_mag}󰎆 Buscar Música (Modo Cava){rst}"
                if music_mode
                else f"{c_cyn} Pesquisar no YouTube{rst}"
            )
            title_r = f"{c_mut}Esc: Voltar{rst}"

            lines: list[str] = []
            lines.append(lm + self._box_top(inner_w, title_l, title_r, b_col))
            lines.append(lm + self._box_line("", inner_w, b_col))

            # Caixa de input estilizada
            input_bg = THEME.ansi_bg("darker_background")
            cursor_ch = f"{c_yel}▌{input_bg}" if hist_idx == -1 else ""
            shown_q = query if visible_len(query) <= inner_w - 10 else query[-(inner_w - 10):]
            if not shown_q and hist_idx == -1:
                prompt_inner = f" {c_cyn}❯{input_bg} {cursor_ch}{c_mut}Digite sua busca e pressione Enter..."
            else:
                prompt_inner = f" {c_cyn}❯{input_bg} {c_fg}{shown_q}{cursor_ch}"
            lines.append(lm + self._box_line(prompt_inner, inner_w, b_col, bg=input_bg))
            lines.append(lm + self._box_line("", inner_w, b_col))

            if recent:
                lines.append(lm + self._box_div(inner_w, dim_b))
                lines.append(
                    lm + self._box_line(
                        f"{c_acc}󰋚 Pesquisas Recentes{rst} {c_mut}(use ↓ para selecionar){rst}",
                        inner_w,
                        b_col,
                    )
                )
                for i, rq in enumerate(recent):
                    srq = truncate_plain(rq, inner_w - 8)
                    if i == hist_idx:
                        row = f"{c_acc}┃ ❯{sel_bg} {c_fg}{srq}"
                        lines.append(lm + self._box_line(row, inner_w, b_col, bg=sel_bg))
                    else:
                        row = f"    {c_mut}•{rst} {c_txt}{srq}{rst}"
                        lines.append(lm + self._box_line(row, inner_w, b_col))

            lines.append(lm + self._box_div(inner_w, dim_b))
            hint = (
                f" {c_yel}[Enter]{rst} {c_mut}Buscar{rst}  "
                f"{c_yel}[↑/↓]{rst} {c_mut}Recentes{rst}  "
                f"{c_yel}[Ctrl+U]{rst} {c_mut}Limpar{rst}  "
                f"{c_red}[Esc]{rst} {c_mut}Voltar{rst}"
            )
            if visible_len(hint) > inner_w:
                hint = (
                    f" {c_yel}[Enter]{rst} {c_mut}Buscar{rst}  "
                    f"{c_yel}[↑/↓]{rst} {c_mut}Recentes{rst}  "
                    f"{c_red}[Esc]{rst} {c_mut}Voltar{rst}"
                )
            lines.append(lm + self._box_line(hint, inner_w, b_col))
            lines.append(lm + self._box_bot(inner_w, b_col))

            top_pad = max(0, (rows - len(lines)) // 2)
            out = ["\033[?2026h\033[H"] + ["\033[K"] * top_pad + [f"{ln}\033[K" for ln in lines] + ["\033[J\033[?2026l"]
            sys.stdout.write("\n".join(out))
            sys.stdout.flush()

            key = _read_key(self.tty_fd, timeout=0.15)
            if key is None:
                continue
            if key in ("ESC", "CTRL_C"):
                return None
            if key == "ENTER":
                chosen = recent[hist_idx] if (0 <= hist_idx < len(recent)) else query.strip()
                if chosen:
                    return chosen
                if music_mode:
                    # Permite abrir o modo música direto com a lista/histórico atual se vazio
                    return ""
                continue
            if key == "DOWN" and recent:
                hist_idx = min(len(recent) - 1, hist_idx + 1)
                continue
            if key == "UP" and recent:
                hist_idx = max(-1, hist_idx - 1)
                continue
            if key == "CTRL_U":
                query = ""
                hist_idx = -1
                continue
            if key == "BACKSPACE":
                hist_idx = -1
                query = query[:-1]
                continue
            if len(key) == 1 and key.isprintable():
                hist_idx = -1
                query += key

