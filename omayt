                        right = f"{c_mut}{sz}{rst} "
                        gap = max(1, inner_w - visible_len(left) - visible_len(right))
                        lines.append(lm + self._box_line(f"{left}{' ' * gap}{right}", inner_w, b_col))

            lines.append(lm + self._box_div(inner_w, dim_b))
