            out = ["\033[?2026h\033[H"] + ["\033[K"] * top_pad + [f"{ln}\033[K" for ln in lines] + ["\033[J\033[?2026l"]
            sys.stdout.write("\n".join(out))
            sys.stdout.flush()

            key = _read_key(self.tty_fd, timeout=0.15)
            if key is None:
                continue
            if key in ("ESC", "CTRL_C", "q", "Q"):
                return None
            if not files:
                if key == "ENTER":
                    return None
                continue
            if key in ("DOWN", "j", "J"):
                sel = (sel + 1) % len(files)
            elif key in ("UP", "k", "K"):
                sel = (sel - 1) % len(files)
            elif key == "ENTER":
                chosen = files[sel]
                mode = "audio" if chosen.suffix.lower() in audio_exts else "window"
                return (chosen, mode)
            elif key in ("a", "A"):
                return (files[sel], "audio")
            elif key in ("i", "I"):
                return (files[sel], "inline-pixels")

