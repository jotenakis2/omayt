def get_video_info(video_id: str) -> dict[str, Any]:
    db = load_json_file(VIDEOS_DB_FILE, {})
    if video_id in db:
        return db[video_id]
    for h in load_json_file(HISTORY_FILE, []):
        if h.get("id") == video_id:
            return h
    return {
        "id": video_id,
        "title": f"YouTube ({video_id})",
        "channel": "YouTube",
        "url": f"https://www.youtube.com/watch?v={video_id}",
    }


def play_video(video_id: str, mode: str = "window") -> None:
    ensure_dirs()
    video = get_video_info(video_id)
    url = video.get("url") or f"https://www.youtube.com/watch?v={video_id}"
    title = video.get("title") or url

    record_watch_history(video)

    c_acc = THEME.ansi_fg("accent", bold=True)
    c_grn = THEME.ansi_fg("green", bold=True)
    c_yel = THEME.ansi_fg("yellow", bold=True)
    c_mut = THEME.ansi_fg("muted")
    rst = THEME.reset

    wrapper = ensure_ytdl_wrapper()

    base_cmd = [
        "mpv",
        f"--script-opts=ytdl_hook-ytdl_path={wrapper}",
        f"--ytdl-raw-options-append=extractor-args={EXTRACTOR_ARGS_CLI}",
        "--stream-lavf-o=reconnect=1,reconnect_streamed=1,reconnect_on_http_error=4xx,reconnect_delay_max=5",
        f"--force-media-title={title}",
    ]

    if mode == "audio":
        audio_cmd = list(base_cmd) + ["--no-video", "--ytdl-format=bestaudio/best", url]
        cava_player = CavaVisualizerPlayer(video, audio_cmd)
        start_ts = time.time()
        rc = cava_player.run()
        elapsed = time.time() - start_ts
        if rc != 0 and elapsed < 4.5:
            _show_ad_wait_countdown(4.0)
            CavaVisualizerPlayer(video, audio_cmd).run()
        return

    no_av1_1080 = "bestvideo[height<=?1080][vcodec!^=av01]+bestaudio/best[vcodec!^=av01]/best"
    no_av1_720 = "bestvideo[height<=?720][vcodec!^=av01]+bestaudio/best[height<=?720][vcodec!^=av01]/best[vcodec!^=av01]/best"

    if mode == "inline-pixels":
        is_kitty_or_ghostty = bool(
            os.environ.get("KITTY_WINDOW_ID") or os.environ.get("GHOSTTY_RESOURCES_DIR")
        )
        if is_kitty_or_ghostty:
            base_cmd.extend(["--vo=kitty", "--hwdec=vaapi-copy", f"--ytdl-format={no_av1_720}", "--profile=sw-fast", "--really-quiet"])
            mode_label = "Vídeo Inline no Terminal (Kitty Graphics Protocol • VA-API)"
        else:
            base_cmd.extend(["--vo=sixel", "--hwdec=vaapi-copy", f"--ytdl-format={no_av1_720}", "--profile=sw-fast", "--really-quiet"])
            mode_label = "Vídeo Inline no Terminal (Sixel Graphics - Foot • VA-API)"
    elif mode == "inline-blocks":
        base_cmd.extend(["--vo=tct", "--hwdec=vaapi-copy", f"--ytdl-format={no_av1_720}", "--profile=sw-fast", "--really-quiet"])
        mode_label = "Vídeo no Terminal (Blocos TrueColor TCT • VA-API)"
    else:
        base_cmd.extend(["--hwdec=vaapi,vaapi-copy", f"--ytdl-format={no_av1_1080}"])
        mode_label = "Janela MPV (Wayland • Aceleração de Hardware VA-API)"

    base_cmd.append(url)

    os.system("clear")
    print(f"\n  {c_acc}󰗃 omayt{rst} • {c_grn}{mode_label}{rst}")
    print(f"  {c_yel}▶{rst} {title}")
    print(f"  {c_mut}🛡️ GPU Decode: VA-API (Intel Iris Xe) | Anti-AdBlock: default,-tv_samsung{rst}")
    if mode.startswith("inline"):
        print(f"  {c_mut}💡 Dica: Aperte 'q' para parar o vídeo e voltar à TUI, 'espaço' para pausar, ←/→ para avançar.{rst}\n")
    else:
        print(f"  {c_mut}💡 Dica: Feche a janela do mpv (ou aperte 'q') para voltar à TUI do omayt.{rst}\n")

    start_ts = time.time()
    proc = subprocess.run(base_cmd)
    elapsed = time.time() - start_ts

    if proc.returncode != 0 and elapsed < 5.0:
        print(
            f"\n  {c_yel}⚠ O YouTube reteve o stream temporariamente por anúncio.{rst}"
        )
        _show_ad_wait_countdown(4.0)
        subprocess.run(base_cmd)


def download_video(video_id: str) -> None:
    ensure_dirs()
    DOWNLOAD_DIR.mkdir(parents=True, exist_ok=True)
    video = get_video_info(video_id)
    url = video.get("url") or f"https://www.youtube.com/watch?v={video_id}"
    title = video.get("title") or video_id

    c_acc = THEME.ansi_fg("accent", bold=True)
    c_grn = THEME.ansi_fg("green", bold=True)
    c_yel = THEME.ansi_fg("yellow", bold=True)
    rst = THEME.reset

    os.system("clear")
    print(f"\n  {c_acc}󰇚 Download • omayt{rst}")
    print(f"  {c_yel}Vídeo:{rst} {title}")
    print(f"  {c_yel}Pasta:{rst} {DOWNLOAD_DIR}\n")
    print(f"  Escolha o formato: {c_grn}[1] Vídeo MP4 (VP9/H.264){rst}  |  {c_acc}[2] Apenas Áudio MP3{rst}  |  [q] Cancelar")
    try:
        choice = input("  > ").strip().lower()
    except (EOFError, KeyboardInterrupt):
        return

    if choice == "q":
        return

    cmd = [
        YTDLP_BIN,
        "--extractor-args",
        EXTRACTOR_ARGS_CLI,
        "-S",
        "vcodec:h264,vp9",
        "-P",
        str(DOWNLOAD_DIR),
        "-o",
        "%(title)s [%(id)s].%(ext)s",
    ]
    if choice == "2":
        cmd.extend(["-x", "--audio-format", "mp3"])
    else:
        cmd.extend(["-f", "bestvideo[height<=?1080][vcodec!^=av01]+bestaudio/best[vcodec!^=av01]/best", "--merge-output-format", "mp4"])

    cmd.append(url)
    print()
    subprocess.run(cmd)
    input(f"\n  {c_grn}✓ Processo concluído! Pressione Enter para voltar ao omayt...{rst}")


def copy_link(video_id: str) -> None:
    video = get_video_info(video_id)
    url = video.get("url") or f"https://www.youtube.com/watch?v={video_id}"
    if shutil.which("wl-copy"):
        subprocess.run(["wl-copy", url], stderr=subprocess.DEVNULL)
    if shutil.which("notify-send"):
        subprocess.run(
            ["notify-send", "omayt", f"Link copiado:\n{url}"],
            stderr=subprocess.DEVNULL,
        )


