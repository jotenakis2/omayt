                hint = (
                    f" {c_yel}[Enter]{rst} {c_mut}Tocar{rst}   "
                    f"{c_mag}[a]{rst} {c_mut}Cava{rst}   "
                    f"{c_acc}[i]{rst} {c_mut}Terminal{rst}   "
                    f"{c_red}[q/Esc]{rst} {c_mut}Voltar{rst}"
