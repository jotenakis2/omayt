                if all(visible_len(row) <= inner_w for row in halves):
                    action_rows = halves
                else:
                    action_rows = [
                        f" {c_yel}[f]{rst} {c_mut}{tr('Fix', 'Corriger', 'Corrigir')}{rst}  "
                        f"{c_yel}[c]{rst} {c_mut}Cache{rst}  "
                        f"{c_yel}[h]{rst} {c_mut}{tr('Searches', 'Recherches', 'Buscas')}{rst}  "
                        f"{c_red}{key_back}{rst} {c_mut}{back_lbl}{rst}"
                    ]
            for action_row in action_rows:
                lines.append(lm + self._box_line(action_row, inner_w, b_col))
            lines.append(lm + self._box_bot(inner_w, b_col))

            top_pad = max(0, (rows - len(lines)) // 2)
            out = ["\033[?2026h\033[H"] + ["\033[K"] * top_pad + [f"{ln}\033[K" for ln in lines] + ["\033[J\033[?2026l"]
            sys.stdout.write("\n".join(out))
            sys.stdout.flush()

            key = _read_key(self.tty_fd, timeout=0.15)
            if key is None:
                continue
            if key in ("ESC", "CTRL_C", "q", "Q", "ENTER"):
                return
            if key in ("f", "F"):
                ok = ensure_global_ytdlp_fix()
                feedback = (
                    tr(
                        "Anti-403 and VA-API optimizations applied to yt-dlp and mpv!",
                        "Optimisations Anti-403 et VA-API appliquées à yt-dlp et mpv !", 'Otimizações Anti-403 e VA-API aplicadas ao yt-dlp e ao mpv!',
                    )
                    if ok
                    else tr(
                        "Could not write to the configuration folders.",
                        "Impossible d’écrire dans les dossiers de configuration.", 'Não foi possível gravar nas pastas de configuração.',
                    )
                )
            elif key in ("c", "C"):
                removed = 0
                if THUMBS_DIR.is_dir():
                    for entry in list(THUMBS_DIR.iterdir()):
                        try:
                            if entry.is_file():
                                entry.unlink()
                                removed += 1
                        except OSError:
                            pass
                feedback = tr(
                    f"Cache cleared: {removed} thumbnail files removed.",
                    f"Cache vidé : {removed} fichiers de vignettes supprimés.",
                    f"Cache limpo: {removed} arquivos de miniaturas removidos.",
                )
            elif key in ("h", "H"):
                save_json_file(SEARCH_HIST_FILE, [])
                feedback = tr("Recent search history cleared.", "Historique des recherches récentes effacé.", 'Histórico de buscas recentes limpo.')
            elif key in ("l", "L"):
                next_lang = UI_LANGS[(UI_LANGS.index(APP_LANG) + 1) % len(UI_LANGS)]
                if not save_ui_lang(next_lang):
                    env_lang = _env_ui_lang() or ""
                    feedback = tr(
                        f"{LANG_NAMES[next_lang]} saved, but OMAYT_LANG={env_lang} has priority.",
                        f"{LANG_NAMES[next_lang]} enregistré, mais OMAYT_LANG={env_lang} a la priorité.",
                        f"{LANG_NAMES[next_lang]} salvo, mas OMAYT_LANG={env_lang} tem prioridade.",
                    )
                else:
                    feedback = ""

    def run(self) -> int:
        ensure_dirs()
        ensure_global_ytdlp_fix()

        while True:
            items = self._build_menu_items()
            sel_indices = self._selectable_indices(items)
            if self.selected not in sel_indices:
                self.selected = sel_indices[0]

            if not self._enter_screen():
                # Fallback without an interactive TTY -> open the default TUI
                return run_tui()

            action_id: str | None = None
            payload: Any = None

            try:
                while True:
                    self._render_main_frame(items)
                    assert self.tty_fd is not None
                    key = _read_key(self.tty_fd, timeout=0.065)
                    if key is None:
                        continue

                    if key in ("ESC", "CTRL_C", "q", "Q"):
                        action_id = "quit"
                        break
                    elif key in ("DOWN", "j", "J", "TAB"):
                        pos = sel_indices.index(self.selected)
                        self.selected = sel_indices[(pos + 1) % len(sel_indices)]
                    elif key in ("UP", "k", "K"):
                        pos = sel_indices.index(self.selected)
                        self.selected = sel_indices[(pos - 1) % len(sel_indices)]
                    elif key in ("HOME", "g"):
                        self.selected = sel_indices[0]
                    elif key in ("END", "G"):
                        self.selected = sel_indices[-1]
                    elif key == "/":
                        q = self._prompt_search(music_mode=False)
                        if q:
                            action_id = "search_go"
                            payload = q
                            break
                    elif key == "ENTER":
                        chosen_id = items[self.selected]["id"]
                        if chosen_id == "search":
                            q = self._prompt_search(music_mode=False)
                            if q:
                                action_id = "search_go"
                                payload = q
                                break
                        elif chosen_id == "music":
                            q = self._prompt_search(music_mode=True)
                            if q is not None:
                                action_id = "music_go"
                                payload = q
                                break
                        elif chosen_id == "url":
                            res = self._prompt_direct_url()
                            if res is not None:
                                action_id = "url_go"
                                payload = res
                                break
                        elif chosen_id == "downloads":
                            res_dl = self._show_downloads_library()
                            if res_dl is not None:
                                action_id = "local_go"
                                payload = res_dl
                                break
                        elif chosen_id == "diagnostics":
                            self._show_diagnostics()
                        else:
                            action_id = chosen_id
                            break
                    elif len(key) == 1 and key.isdigit():
                        for idx, it in enumerate(items):
                            if it.get("key") == key:
                                self.selected = idx
                                chosen_id = it["id"]
                                if chosen_id == "search":
                                    q = self._prompt_search(music_mode=False)
                                    if q:
                                        action_id = "search_go"
                                        payload = q
                                        break
                                elif chosen_id == "music":
                                    q = self._prompt_search(music_mode=True)
                                    if q is not None:
                                        action_id = "music_go"
                                        payload = q
                                        break
                                elif chosen_id == "url":
                                    res = self._prompt_direct_url()
                                    if res is not None:
                                        action_id = "url_go"
                                        payload = res
                                        break
                                elif chosen_id == "downloads":
                                    res_dl = self._show_downloads_library()
                                    if res_dl is not None:
                                        action_id = "local_go"
                                        payload = res_dl
                                        break
                                elif chosen_id == "diagnostics":
                                    self._show_diagnostics()
                                else:
                                    action_id = chosen_id
                                    break
                        if action_id:
                            break
            finally:
                self._leave_screen()

            # Run the chosen action outside the alternate screen (fzf / mpv / Cava)
            if action_id == "quit" or action_id is None:
                return 0
            elif action_id == "search_go":
                run_tui(initial_query=str(payload), from_menu=True)
            elif action_id == "resume":
                run_tui(from_menu=True)
            elif action_id == "history":
                run_tui(start_in_history=True, from_menu=True)
            elif action_id == "music_go":
                run_tui(initial_query=str(payload), default_mode="audio", from_menu=True)
            elif action_id == "url_go":
                url_str, mode = payload
                vid = extract_youtube_id(url_str)
                if mode == "download":
                    if vid:
                        download_video(vid)
                    else:
                        download_video(url_str)
                elif vid:
                    play_video(vid, mode=mode)
                else:
                    play_direct_target(url_str, url_str, mode=mode, is_local=False)
            elif action_id == "local_go":
                file_path, mode = payload
                play_direct_target(str(file_path), file_path.stem, mode=mode, is_local=True)


def run_main_menu() -> int:
    return OmarchyMainMenu().run()


