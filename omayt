def _read_key(tty_fd: int, timeout: float = 0.065) -> str | None:
    """Lê uma tecla (incluindo setas, Esc e UTF-8 acentuado) sem bloquear além de timeout."""
    rlist, _, _ = select.select([tty_fd], [], [], timeout)
    if not rlist:
        return None
    b = os.read(tty_fd, 1)
    if not b:
        return None

    if b == b"\x1b":
        # Verificar se é uma sequência de escape (seta, Home/End, Alt+tecla) ou Esc puro
        seq = b
        while True:
            r2, _, _ = select.select([tty_fd], [], [], 0.015)
            if not r2:
                break
            nxt = os.read(tty_fd, 1)
            if not nxt:
                break
            seq += nxt
            if len(seq) >= 6 or (len(seq) >= 3 and seq[1:2] in (b"[", b"O") and (64 <= nxt[0] <= 126)):
                break
        if seq == b"\x1b":
            return "ESC"
        if seq in (b"\x1b[A", b"\x1bOA"):
            return "UP"
        if seq in (b"\x1b[B", b"\x1bOB"):
            return "DOWN"
        if seq in (b"\x1b[C", b"\x1bOC"):
            return "RIGHT"
        if seq in (b"\x1b[D", b"\x1bOD"):
            return "LEFT"
        if seq in (b"\x1b[H", b"\x1b[1~", b"\x1bOH"):
            return "HOME"
        if seq in (b"\x1b[F", b"\x1b[4~", b"\x1bOF"):
            return "END"
        if seq == b"\x1b[3~":
            return "DEL"
        return "UNKNOWN"

    if b == b"\x03":
        return "CTRL_C"
    if b == b"\x15":
        return "CTRL_U"
    if b in (b"\r", b"\n"):
        return "ENTER"
    if b in (b"\x7f", b"\x08"):
        return "BACKSPACE"
    if b == b"\t":
        return "TAB"

    first = b[0]
    if first < 0x80:
        return b.decode("ascii", errors="ignore")

    # Caractere UTF-8 multibyte (ex: á, ã, ç, é)
    need = 0
    if (first & 0xE0) == 0xC0:
        need = 1
    elif (first & 0xF0) == 0xE0:
        need = 2
    elif (first & 0xF8) == 0xF0:
        need = 3
    buf = b
    for _ in range(need):
        r_mb, _, _ = select.select([tty_fd], [], [], 0.02)
        if not r_mb:
            break
        buf += os.read(tty_fd, 1)
    return buf.decode("utf-8", errors="ignore")


class OmarchyMainMenu:
