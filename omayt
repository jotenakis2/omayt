def main(argv: list[str]) -> int:
    ensure_dirs()
    if not argv:
        return run_main_menu()

    cmd = argv[0]

    if cmd in ("-h", "--help"):
        print_help()
        return 0

    if cmd in ("-v", "--version"):
        print(f"omayt {APP_VERSION}")
        return 0

    if cmd in ("-m", "--menu"):
        return run_main_menu()

    if cmd in ("-t", "--no-menu"):
        rest = " ".join(argv[1:]).strip()
        return run_tui(initial_query=rest)

    if cmd in ("-H", "--history"):
        return run_tui(start_in_history=True)

    if cmd == "--fix-ytdlp":
        ensure_dirs()
        ok = ensure_global_ytdlp_fix()
        if ok:
            print(
                tr(
                    "✓ Configured ~/.config/yt-dlp/config and ~/.config/mpv/mpv.conf (VA-API + Anti-403)",
                    "✓ ~/.config/yt-dlp/config et ~/.config/mpv/mpv.conf configurés (VA-API + Anti-403)", '✓ ~/.config/yt-dlp/config e ~/.config/mpv/mpv.conf configurados (VA-API + Anti-403)',
                )
            )
        else:
            print(
                tr(
                    "⚠ Could not write the global configuration.",
                    "⚠ Impossible d’écrire la configuration globale.", '⚠ Não foi possível gravar a configuração global.',
                )
            )
        return 0 if ok else 1

    if cmd == "--internal-search":
        query = " ".join(argv[1:]).strip()
        if query:
            videos = search_youtube(query)
            print(format_tui_rows(videos, f"{tr('Search:', 'Recherche :', 'Busca:')} {query}"))
        else:
            videos = load_json_file(LAST_LIST_FILE, []) or load_json_file(HISTORY_FILE, [])
            print(
                format_tui_rows(
                    videos,
                    tr(
                        "Type a term above and press Enter or Ctrl+S",
                        "Saisissez un terme ci-dessus puis Entrée ou Ctrl+S", 'Digite um termo acima e pressione Enter ou Ctrl+S',
                    ),
                )
            )
        return 0

    if cmd == "--internal-history":
        videos = load_json_file(HISTORY_FILE, [])
        save_json_file(LAST_LIST_FILE, videos)
        prefetch_thumbnails_async([v.get("id", "") for v in videos])
        print(format_tui_rows(videos, tr("Watched Video History", "Historique des vidéos vues", 'Histórico de vídeos assistidos')))
        return 0

    if cmd == "--internal-preview":
        item_id = argv[1] if len(argv) > 1 else ""
        curr_q = " ".join(argv[2:]) if len(argv) > 2 else ""
        render_preview_pane(item_id, curr_q)
        return 0

    if cmd == "--internal-prefetch":
        run_prefetch_worker(argv[1:])
        return 0

    if cmd == "--sixel":
        if len(argv) >= 2:
            img_p = Path(argv[1])
            w_px = int(argv[2]) if len(argv) >= 3 and argv[2].isdigit() else 640
            if img_p.is_file():
                encode_image_to_sixel_stdout(img_p, w_px)
                sys.stdout.write("\n")
        return 0

    if cmd == "--internal-ytdl-hook":
        return run_ytdl_hook_wrapper(argv[1:])

    return run_tui(initial_query=" ".join(argv))


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv[1:]))
    except KeyboardInterrupt:
        sys.exit(130)
