            sys.stdout.write("\n".join(out))
            sys.stdout.flush()

            key = _read_key(self.tty_fd, timeout=0.15)
            if key is None:
                continue
            if key in ("ESC", "CTRL_C"):
                return None
            if key == "ENTER":
                chosen = recent[hist_idx] if (0 <= hist_idx < len(recent)) else query.strip()
                if chosen:
                    return chosen
                if music_mode:
                    # Allows opening music mode directly with the current list/history if empty
                    return ""
                continue
            if key == "DOWN" and recent:
                hist_idx = min(len(recent) - 1, hist_idx + 1)
                continue
            if key == "UP" and recent:
                hist_idx = max(-1, hist_idx - 1)
                continue
            if key == "CTRL_U":
                query = ""
                hist_idx = -1
                continue
            if key == "BACKSPACE":
                hist_idx = -1
                query = query[:-1]
                continue
            if len(key) == 1 and key.isprintable():
                hist_idx = -1
                query += key

