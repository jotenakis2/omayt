def thumb_path_for(video_id: str) -> Path:
    safe_id = re.sub(r"[^a-zA-Z0-9_-]", "", video_id)
    return THUMBS_DIR / f"{safe_id}.jpg"


def download_single_thumb(video_id: str, fallback_url: str = "") -> Path | None:
    if not video_id or video_id.startswith("__"):
        return None
    dest = thumb_path_for(video_id)
    if dest.is_file() and dest.stat().st_size > 1000:
        return dest

    urls = [
        f"https://i.ytimg.com/vi/{video_id}/maxresdefault.jpg",
        f"https://i.ytimg.com/vi/{video_id}/sddefault.jpg",
        f"https://i.ytimg.com/vi/{video_id}/hqdefault.jpg",
    ]
    if fallback_url and fallback_url not in urls:
        urls.append(fallback_url)

    for url in urls:
        try:
            req = urllib.request.Request(
                url,
                headers={"User-Agent": "Mozilla/5.0 (X11; Linux x86_64) omayt/1.2"},
            )
            with urllib.request.urlopen(req, timeout=3.5) as resp:
                data = resp.read()
                if len(data) > 1000:
                    tmp = dest.with_suffix(f".tmp.{os.getpid()}.{threading.get_ident()}")
                    tmp.write_bytes(data)
                    os.replace(tmp, dest)
                    return dest
        except Exception:
            continue
    return None


def prefetch_thumbnails_async(video_ids: list[str]) -> None:
    missing = [
        vid for vid in video_ids
        if vid and not vid.startswith("__") and not thumb_path_for(vid).is_file()
    ]
    if not missing:
        return
    try:
        subprocess.Popen(
            [sys.executable, str(Path(__file__).resolve()), "--internal-prefetch", *missing],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            start_new_session=True,
        )
    except Exception:
        pass


def run_prefetch_worker(video_ids: list[str]) -> None:
    ensure_dirs()
    with concurrent.futures.ThreadPoolExecutor(max_workers=10) as pool:
        pool.map(download_single_thumb, video_ids)


def _get_terminal_cell_pixel_size() -> tuple[float, float]:
    for fd_path in ("/dev/tty",):
        try:
            with open(fd_path, "rb") as tty_f:
                buf = fcntl.ioctl(tty_f.fileno(), termios.TIOCGWINSZ, b"\x00" * 8)
                rows, cols, xpixel, ypixel = struct.unpack("HHHH", buf)
                if rows > 0 and cols > 0 and xpixel > 0 and ypixel > 0:
                    return (xpixel / cols, ypixel / rows)
        except Exception:
            pass
    return (11.0, 22.0)


def compute_optimal_thumb_px_width(preview_cols: int, preview_lines: int) -> int:
    cell_w, cell_h = _get_terminal_cell_pixel_size()
    avail_w = int(max(30, preview_cols - 2) * cell_w)
    avail_h = int(max(12, preview_lines - 11) * cell_h)
    max_w_from_h = int(avail_h * 16 / 9)

    px_w = min(avail_w, max_w_from_h)
    px_w = (max(480, min(px_w, 1152)) // 32) * 32
    return px_w


def encode_image_to_sixel_stdout(img_path: Path, px_width: int = 640) -> bool:
    px_w = max(320, min(px_width, 1280))
    px_h = int(px_w * 9 / 16)
    px_h = (px_h // 6) * 6

    THUMBS_DIR.mkdir(parents=True, exist_ok=True)
    sixel_cache = THUMBS_DIR / f"{img_path.stem}_{px_w}x{px_h}.sixel"
    if sixel_cache.is_file() and sixel_cache.stat().st_size > 500:
        try:
            sys.stdout.flush()
            sys.stdout.buffer.write(sixel_cache.read_bytes())
            sys.stdout.buffer.flush()
            return True
        except Exception:
            pass

    lib_path = "/usr/lib/libsixel.so.1"
    if os.path.exists(lib_path) and shutil.which("ffmpeg"):
        try:
            import ctypes

            vf_chain = (
                f"crop=iw:iw*9/16,"
                f"scale={px_w}:{px_h}:flags=lanczos,"
                f"unsharp=3:3:0.65:3:3:0.0"
            )
            raw_rgb = subprocess.check_output(
                [
                    "ffmpeg",
                    "-v",
                    "error",
                    "-i",
                    str(img_path),
                    "-vf",
                    vf_chain,
                    "-f",
                    "rawvideo",
                    "-pix_fmt",
                    "rgb24",
                    "-",
                ],
                stderr=subprocess.DEVNULL,
                timeout=4.0,
            )
            if len(raw_rgb) == px_w * px_h * 3:
                lib = ctypes.CDLL(lib_path)
                encoder = ctypes.c_void_p()
                if lib.sixel_encoder_new(ctypes.byref(encoder), None) == 0:
                    tmp_sixel = sixel_cache.with_suffix(f".tmp.{os.getpid()}")
                    opts = [
                        (ord("q"), b"high"),
                        (ord("p"), b"256"),
                        (ord("s"), b"histogram"),
                        (ord("f"), b"lum"),
                        (ord("C"), b"2"),
                        (ord("o"), str(tmp_sixel).encode("utf-8")),
                    ]
                    for flag, val in opts:
                        lib.sixel_encoder_setopt(encoder, flag, ctypes.c_char_p(val))

                    res = lib.sixel_encoder_encode_bytes(
                        encoder, raw_rgb, px_w, px_h, 3, None, -1
                    )
                    lib.sixel_encoder_unref(encoder)

                    if res == 0 and tmp_sixel.is_file() and tmp_sixel.stat().st_size > 100:
                        os.replace(tmp_sixel, sixel_cache)
                        sys.stdout.flush()
                        sys.stdout.buffer.write(sixel_cache.read_bytes())
                        sys.stdout.buffer.flush()
                        return True
                    elif tmp_sixel.is_file():
                        tmp_sixel.unlink(missing_ok=True)
        except Exception:
            pass

    return False


def render_thumbnail_to_stdout(img_path: Path, preview_cols: int, preview_lines: int) -> None:
    if not img_path.is_file():
        return

    cols = max(30, min(preview_cols - 2, 110))
    img_rows = max(12, min(preview_lines - 11, 28))
    px_width = compute_optimal_thumb_px_width(preview_cols, preview_lines)

    is_kitty_or_ghostty = bool(
        os.environ.get("KITTY_WINDOW_ID") or os.environ.get("GHOSTTY_RESOURCES_DIR")
    )

    if is_kitty_or_ghostty and shutil.which("kitten"):
        dim = f"{cols}x{img_rows}@0x0"
        proc = subprocess.run(
            [
                "kitten",
                "icat",
                "--clear",
                "--transfer-mode=memory",
                "--unicode-placeholder",
                "--stdin=no",
                f"--place={dim}",
                str(img_path),
            ],
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            text=True,
        )
        if proc.returncode == 0 and proc.stdout:
            lines = proc.stdout.splitlines()
            if lines:
                lines[-1] = lines[-1] + "\033[m"
                sys.stdout.write("\n".join(lines) + "\n")
                sys.stdout.flush()
                return

    if encode_image_to_sixel_stdout(img_path, px_width):
        sys.stdout.write("\n")
        sys.stdout.flush()
        return

    if shutil.which("chafa"):
        subprocess.run(
