def run_tui(initial_query: str = "", start_in_history: bool = False) -> int:
    ensure_dirs()
    ensure_global_ytdlp_fix()

    if not shutil.which("fzf"):
        sys.stderr.write("Erro: 'fzf' não está instalado.\n")
        return 1

    script = str(Path(__file__).resolve())
    current_query = initial_query.strip()

    if start_in_history:
        videos = load_json_file(HISTORY_FILE, [])
        save_json_file(LAST_LIST_FILE, videos)
        prefetch_thumbnails_async([v.get("id", "") for v in videos])
        header_note = "Histórico de Vídeos Assistidos"
    elif current_query:
        c_acc = THEME.ansi_fg("accent", bold=True)
        rst = THEME.reset
        sys.stderr.write(f"  {c_acc}󰗃 omayt:{rst} Pesquisando “{current_query}” no YouTube...\r")
        sys.stderr.flush()
        videos = search_youtube(current_query)
        header_note = f"Busca: {current_query}"
    else:
        videos = load_json_file(LAST_LIST_FILE, [])
        if not videos:
            videos = load_json_file(HISTORY_FILE, [])
            header_note = "Histórico Recente" if videos else ""
        else:
            state = load_json_file(STATE_FILE, {})
            current_query = state.get("query", "")
            header_note = f"Última busca: {current_query}" if current_query else ""
        prefetch_thumbnails_async([v.get("id", "") for v in videos])

    while True:
        rows_text = format_tui_rows(videos, header_note)
        load_pos = "pos(2)" if videos else "pos(1)"

        header_bar = (
            "Enter:Abrir/Buscar │ Ctrl-S:Buscar │ Alt-I:Vídeo Terminal │ "
            "Alt-A:󰎆 Áudio+Cava │ Alt-D:Baixar │ Ctrl-H:Histórico"
        )

        label_query = f" • Busca: {current_query}" if current_query else ""

        fzf_cmd = [
            "fzf",
            "--ansi",
            "--disabled",
            "--print-query",
            "--layout=reverse",
            "--height=100%",
            "--border=rounded",
            f"--border-label= 󰗃 omayt • Omarchy YouTube TUI [Tema: {THEME.name}{label_query}] ",
            "--border-label-pos=3",
            "--preview-label= 󰥶 Thumbnail HD & Detalhes ",
            "--delimiter=\t",
            "--with-nth=2..",
            "--prompt=  Pesquisar no YouTube > ",
            f"--header={header_bar}",
            "--header-first",
            "--preview-window=right:55%:border-rounded:wrap",
            f"--preview=python3 {script} --internal-preview {{1}} {{q}}",
            f"--bind=load:{load_pos}",
            "--bind=change:first",
            "--bind=enter:print(enter)+accept",
            "--bind=ctrl-s:print(search)+accept",
            "--bind=ctrl-h:print(history)+accept",
            "--bind=alt-i:print(alt-i)+accept",
            "--bind=ctrl-t:print(ctrl-t)+accept",
            "--bind=alt-b:print(alt-b)+accept",
            "--bind=alt-a:print(alt-a)+accept",
            "--bind=alt-d:print(alt-d)+accept",
            "--bind=alt-l:print(alt-l)+accept",
            "--bind=ctrl-f:toggle-search",
            THEME.fzf_color_arg(),
        ]

        fzf_env = dict(os.environ)
        fzf_env["SHELL"] = "/bin/sh"

        proc = subprocess.run(
            fzf_cmd,
            input=rows_text,
            stdout=subprocess.PIPE,
            text=True,
            env=fzf_env,
        )

        if proc.returncode != 0 and not proc.stdout:
            break

        out_lines = proc.stdout.splitlines()
        typed_query = out_lines[0].strip() if len(out_lines) >= 1 else ""
        action = out_lines[1].strip() if len(out_lines) >= 2 else "enter"
        selected_line = out_lines[2] if len(out_lines) >= 3 else ""

        video_id = (
            selected_line.split("\t", 1)[0].strip()
            if "\t" in selected_line
            else ""
        )

        if action == "history" or (video_id == "__HISTORY__" and not typed_query):
            videos = load_json_file(HISTORY_FILE, [])
            save_json_file(LAST_LIST_FILE, videos)
            prefetch_thumbnails_async([v.get("id", "") for v in videos])
            header_note = "Histórico de Vídeos Assistidos"
            current_query = ""
            continue

        if action == "search" or video_id in ("__SEARCH__", "__HISTORY__") or not video_id:
            q = typed_query
            if not q:
                c_acc = THEME.ansi_fg("accent", bold=True)
                c_yel = THEME.ansi_fg("yellow", bold=True)
                rst = THEME.reset
                os.system("clear")
                print(f"\n  {c_acc}󰗃 omayt • Nova Pesquisa no YouTube{rst}")
                try:
                    q = input(f"  {c_yel}  Digite sua busca:{rst} ").strip()
                except (EOFError, KeyboardInterrupt):
                    continue
            if q:
                c_acc = THEME.ansi_fg("accent", bold=True)
                rst = THEME.reset
                os.system("clear")
                print(f"\n  {c_acc}󰗃 omayt:{rst} Pesquisando “{q}” no YouTube e carregando thumbnails HD...")
                videos = search_youtube(q)
                current_query = q
                header_note = f"Busca: {q}"
            continue

        if action in ("alt-i", "ctrl-t"):
            play_video(video_id, mode="inline-pixels")
        elif action == "alt-b":
            play_video(video_id, mode="inline-blocks")
        elif action == "alt-a":
            play_video(video_id, mode="audio")
        elif action == "alt-d":
            download_video(video_id)
        elif action == "alt-l":
            copy_link(video_id)
        else:
            play_video(video_id, mode="window")

        videos = load_json_file(LAST_LIST_FILE, videos)

    return 0


