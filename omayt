            lines.append(
                lm + self._box_top(
                    inner_w,
                    f"{c_blu}󰇚 Biblioteca de Downloads{rst}",
                    f"{c_mut}~/Videos/omayt ({len(files)}){rst}",
                    b_col,
                )
