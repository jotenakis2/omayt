                hint = f" {c_red}{tr('[Enter/q/Esc]', '[Entrée/q/Échap]', '[Enter/q/Esc]')}{rst} {c_mut}{tr('Back to Main Menu', 'Retour au menu principal', 'Voltar ao menu principal')}{rst}"
