    def __init__(self) -> None:
        self.selected = 0
        self.start_time = time.time()
        self.status_toast = ""
        self.status_toast_until = 0.0
        self.tty_f: Any = None
        self.tty_fd: int | None = None
        self.old_termios: Any = None

    def _enter_screen(self) -> bool:
        try:
            self.tty_f = open("/dev/tty", "rb", buffering=0)
            self.tty_fd = self.tty_f.fileno()
        except OSError:
            if sys.stdin.isatty():
                self.tty_f = None
                self.tty_fd = sys.stdin.fileno()
            else:
                return False
        try:
            self.old_termios = termios.tcgetattr(self.tty_fd)
            tty.setcbreak(self.tty_fd)
        except Exception:
            if self.tty_f is not None:
                try:
                    self.tty_f.close()
                except Exception:
                    pass
                self.tty_f = None
            self.tty_fd = None
            return False
        sys.stdout.write("\033[?1049h\033[?25l\033[2J\033[H")
        sys.stdout.flush()
        return True

    def _leave_screen(self) -> None:
        if self.old_termios is not None and self.tty_fd is not None:
            try:
                termios.tcsetattr(self.tty_fd, termios.TCSADRAIN, self.old_termios)
            except Exception:
                pass
        if self.tty_f is not None:
            try:
                self.tty_f.close()
            except Exception:
                pass
        self.tty_f = None
        self.tty_fd = None
        self.old_termios = None
        sys.stdout.write("\033[?25h\033[0m\033[?1049l")
        sys.stdout.flush()

