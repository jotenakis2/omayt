            lines.append(lm + self._box_bot(inner_w, b_col))

            top_pad = max(0, (rows - len(lines)) // 2)
            out = ["\033[?2026h\033[H"] + ["\033[K"] * top_pad + [f"{ln}\033[K" for ln in lines] + ["\033[J\033[?2026l"]
            sys.stdout.write("\n".join(out))
            sys.stdout.flush()

            key = _read_key(self.tty_fd, timeout=0.15)
            if key is None:
                continue
            if key in ("ESC", "CTRL_C", "q", "Q"):
                return None
            if not files:
                if key == "ENTER":
                    return None
                continue
            if key in ("DOWN", "j", "J"):
                sel = (sel + 1) % len(files)
            elif key in ("UP", "k", "K"):
                sel = (sel - 1) % len(files)
            elif key == "ENTER":
                chosen = files[sel]
                mode = "audio" if chosen.suffix.lower() in audio_exts else "window"
                return (chosen, mode)
            elif key in ("a", "A"):
                return (files[sel], "audio")
            elif key in ("i", "I"):
                return (files[sel], "inline-pixels")

    def _show_diagnostics(self) -> None:
        """Tela de diagnóstico do sistema, paleta Omarchy ativa e manutenção do cache."""
        assert self.tty_fd is not None
        feedback = ""

        while True:
            term = shutil.get_terminal_size((100, 32))
            cols, rows = max(54, term.columns), max(18, term.lines)
            card_w = max(56, min(cols - 4, 78))
            inner_w = card_w - 4
            lm = " " * max(0, (cols - card_w) // 2)

            c_acc = THEME.ansi_fg("accent", bold=True)
            c_org = THEME.ansi_fg("orange", bold=True)
            c_fg = THEME.ansi_fg("bright_foreground", bold=True)
            c_txt = THEME.ansi_fg("light_foreground")
            c_yel = THEME.ansi_fg("yellow", bold=True)
            c_grn = THEME.ansi_fg("green", bold=True)
            c_red = THEME.ansi_fg("red", bold=True)
            c_cyn = THEME.ansi_fg("cyan", bold=True)
            c_mut = THEME.ansi_fg("muted")
            rst = THEME.reset
            b_col = THEME.ansi_fg("orange")
            dim_b = THEME.ansi_fg("muted")

            def badge(ok: bool, name: str) -> str:
                return f"{c_grn}✓{rst} {c_txt}{name}{rst}" if ok else f"{c_red}✗{rst} {c_mut}{name}{rst}"

            checks = [
                (bool(shutil.which("fzf")), "fzf"),
                (bool(shutil.which("yt-dlp")), "yt-dlp"),
                (bool(shutil.which("mpv")), "mpv"),
                (bool(shutil.which("ffmpeg")), "ffmpeg"),
                (os.path.exists("/usr/lib/libsixel.so.1"), "libsixel"),
                (bool(shutil.which("wl-copy")), "wl-copy"),
                (bool(shutil.which("parec") or shutil.which("pw-record")), "PipeWire"),
            ]
            row1 = "   ".join(badge(ok, n) for ok, n in checks[:4])
            row2 = "   ".join(badge(ok, n) for ok, n in checks[4:])

            # Paleta Omarchy
            swatch_keys = ("accent", "cyan", "blue", "green", "yellow", "magenta", "red")
            sw_sep = "  " if inner_w >= 58 else " "
            swatches = sw_sep.join(f"{THEME.ansi_fg(k, bold=True)}██{rst} {c_mut}{k[:3]}{rst}" for k in swatch_keys)

            thumbs_cnt, thumbs_sz = _get_cache_stats()
            watch_cnt = len(load_json_file(HISTORY_FILE, []))
            search_cnt = len(load_json_file(SEARCH_HIST_FILE, []))
            dl_cnt = len(_list_downloaded_files())

            lines: list[str] = []
            lines.append(
                lm + self._box_top(
                    inner_w,
                    f"{c_org}󰒓 Configurações & Diagnóstico{rst}",
                    f"{c_mut}omayt v{APP_VERSION}{rst}",
                    b_col,
                )
            )
            lines.append(lm + self._box_line(f"{c_acc}Dependências do Sistema:{rst}", inner_w, b_col))
            lines.append(lm + self._box_line(f"  {row1}", inner_w, b_col))
            lines.append(lm + self._box_line(f"  {row2}", inner_w, b_col))
            lines.append(lm + self._box_div(inner_w, dim_b))

            lines.append(
                lm + self._box_line(
                    f"{c_acc}Tema Omarchy Ativo:{rst} {c_fg}{THEME.name}{rst}",
                    inner_w,
                    b_col,
                )
            )
            lines.append(lm + self._box_line(f"  {swatches}", inner_w, b_col))
            lines.append(lm + self._box_div(inner_w, dim_b))

            lines.append(lm + self._box_line(f"{c_acc}Armazenamento Local:{rst}", inner_w, b_col))
            lines.append(
                lm + self._box_line(
                    f"  {c_cyn}󰥶 Cache HD :{rst} {c_txt}{thumbs_cnt} arquivos ({_format_bytes(thumbs_sz)}){rst}",
                    inner_w,
                    b_col,
                )
            )
            hist_summary = truncate_plain(
                f"{watch_cnt} vídeos • {search_cnt} pesquisas • {dl_cnt} downloads",
                max(16, inner_w - 16),
            )
            lines.append(
                lm + self._box_line(
                    f"  {c_yel}󰋚 Histórico:{rst} {c_txt}{hist_summary}{rst}",
                    inner_w,
                    b_col,
                )
            )

            if feedback:
                lines.append(lm + self._box_div(inner_w, dim_b))
                lines.append(lm + self._box_line(f" {c_grn}✓{rst} {c_fg}{truncate_plain(feedback, inner_w - 4)}{rst}", inner_w, b_col))

            lines.append(lm + self._box_div(inner_w, dim_b))
            actions = (
                f" {c_yel}[f]{rst} {c_mut}Fix VA-API/403{rst}  "
                f"{c_yel}[c]{rst} {c_mut}Limpar Cache{rst}  "
                f"{c_yel}[h]{rst} {c_mut}Limpar Buscas{rst}  "
                f"{c_red}[q/Esc]{rst} {c_mut}Voltar{rst}"
            )
            if visible_len(actions) > inner_w:
                actions = (
                    f" {c_yel}[f]{rst} {c_mut}Fix{rst}  "
                    f"{c_yel}[c]{rst} {c_mut}Cache{rst}  "
                    f"{c_yel}[h]{rst} {c_mut}Buscas{rst}  "
                    f"{c_red}[q/Esc]{rst} {c_mut}Voltar{rst}"
                )
            lines.append(lm + self._box_line(actions, inner_w, b_col))
            lines.append(lm + self._box_bot(inner_w, b_col))

            top_pad = max(0, (rows - len(lines)) // 2)
            out = ["\033[?2026h\033[H"] + ["\033[K"] * top_pad + [f"{ln}\033[K" for ln in lines] + ["\033[J\033[?2026l"]
            sys.stdout.write("\n".join(out))
            sys.stdout.flush()

            key = _read_key(self.tty_fd, timeout=0.15)
            if key is None:
                continue
            if key in ("ESC", "CTRL_C", "q", "Q", "ENTER"):
                return
            if key in ("f", "F"):
                ok = ensure_global_ytdlp_fix()
                feedback = (
                    "Otimizações Anti-403 e VA-API aplicadas em yt-dlp e mpv!"
                    if ok
                    else "Não foi possível gravar nas pastas de configuração."
                )
            elif key in ("c", "C"):
                removed = 0
                if THUMBS_DIR.is_dir():
                    for entry in list(THUMBS_DIR.iterdir()):
                        try:
                            if entry.is_file():
                                entry.unlink()
                                removed += 1
                        except OSError:
                            pass
                feedback = f"Cache limpo: {removed} arquivos de thumbnails removidos."
            elif key in ("h", "H"):
                save_json_file(SEARCH_HIST_FILE, [])
                feedback = "Histórico de pesquisas recentes limpo."

    def run(self) -> int:
        ensure_dirs()
        ensure_global_ytdlp_fix()

        while True:
            items = self._build_menu_items()
            sel_indices = self._selectable_indices(items)
            if self.selected not in sel_indices:
                self.selected = sel_indices[0]

            if not self._enter_screen():
                # Fallback sem TTY interativo -> abrir TUI padrão
                return run_tui()

            action_id: str | None = None
            payload: Any = None

            try:
                while True:
                    self._render_main_frame(items)
                    assert self.tty_fd is not None
                    key = _read_key(self.tty_fd, timeout=0.065)
                    if key is None:
                        continue

                    if key in ("ESC", "CTRL_C", "q", "Q"):
                        action_id = "quit"
                        break
                    elif key in ("DOWN", "j", "J", "TAB"):
                        pos = sel_indices.index(self.selected)
                        self.selected = sel_indices[(pos + 1) % len(sel_indices)]
                    elif key in ("UP", "k", "K"):
                        pos = sel_indices.index(self.selected)
                        self.selected = sel_indices[(pos - 1) % len(sel_indices)]
                    elif key in ("HOME", "g"):
                        self.selected = sel_indices[0]
                    elif key in ("END", "G"):
                        self.selected = sel_indices[-1]
                    elif key == "/":
                        q = self._prompt_search(music_mode=False)
                        if q:
                            action_id = "search_go"
                            payload = q
                            break
                    elif key == "ENTER":
                        chosen_id = items[self.selected]["id"]
                        if chosen_id == "search":
                            q = self._prompt_search(music_mode=False)
                            if q:
                                action_id = "search_go"
                                payload = q
                                break
                        elif chosen_id == "music":
                            q = self._prompt_search(music_mode=True)
                            if q is not None:
                                action_id = "music_go"
                                payload = q
                                break
                        elif chosen_id == "url":
                            res = self._prompt_direct_url()
                            if res is not None:
                                action_id = "url_go"
                                payload = res
                                break
                        elif chosen_id == "downloads":
                            res_dl = self._show_downloads_library()
                            if res_dl is not None:
                                action_id = "local_go"
                                payload = res_dl
                                break
                        elif chosen_id == "diagnostics":
                            self._show_diagnostics()
                        else:
                            action_id = chosen_id
                            break
                    elif len(key) == 1 and key.isdigit():
                        for idx, it in enumerate(items):
                            if it.get("key") == key:
                                self.selected = idx
                                chosen_id = it["id"]
                                if chosen_id == "search":
                                    q = self._prompt_search(music_mode=False)
                                    if q:
                                        action_id = "search_go"
                                        payload = q
                                        break
                                elif chosen_id == "music":
                                    q = self._prompt_search(music_mode=True)
                                    if q is not None:
                                        action_id = "music_go"
                                        payload = q
                                        break
                                elif chosen_id == "url":
                                    res = self._prompt_direct_url()
                                    if res is not None:
                                        action_id = "url_go"
                                        payload = res
                                        break
                                elif chosen_id == "downloads":
                                    res_dl = self._show_downloads_library()
                                    if res_dl is not None:
                                        action_id = "local_go"
                                        payload = res_dl
                                        break
                                elif chosen_id == "diagnostics":
                                    self._show_diagnostics()
                                else:
                                    action_id = chosen_id
                                    break
                        if action_id:
                            break
            finally:
                self._leave_screen()

            # Executar ação escolhida fora da tela alternativa (fzf / mpv / Cava)
            if action_id == "quit" or action_id is None:
                return 0
            elif action_id == "search_go":
                run_tui(initial_query=str(payload), from_menu=True)
            elif action_id == "resume":
                run_tui(from_menu=True)
            elif action_id == "history":
                run_tui(start_in_history=True, from_menu=True)
            elif action_id == "music_go":
                run_tui(initial_query=str(payload), default_mode="audio", from_menu=True)
            elif action_id == "url_go":
                url_str, mode = payload
                vid = extract_youtube_id(url_str)
                if mode == "download":
                    if vid:
                        download_video(vid)
                    else:
                        download_video(url_str)
                elif vid:
                    play_video(vid, mode=mode)
                else:
                    play_direct_target(url_str, url_str, mode=mode, is_local=False)
            elif action_id == "local_go":
                file_path, mode = payload
                play_direct_target(str(file_path), file_path.stem, mode=mode, is_local=True)


def run_main_menu() -> int:
    return OmarchyMainMenu().run()


