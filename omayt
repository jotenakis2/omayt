def run_tui(
    initial_query: str = "",
    start_in_history: bool = False,
    default_mode: str = "window",
    from_menu: bool = False,
) -> int:
    ensure_dirs()
    ensure_global_ytdlp_fix()

    if not shutil.which("fzf"):
        sys.stderr.write(tr("Error: 'fzf' is not installed.\n", "Erreur : 'fzf' n’est pas installé.\n", "Erro: 'fzf' não está instalado.\n"))
        return 1

    script = str(Path(__file__).resolve())
    current_query = initial_query.strip()
    search_limit = SEARCH_PAGE_SIZE
    has_more = False

    if start_in_history:
        videos = load_json_file(HISTORY_FILE, [])
        save_json_file(LAST_LIST_FILE, videos)
        save_json_file(STATE_FILE, {"mode": "history", "query": "", "count": len(videos), "limit": 0, "has_more": False})
        prefetch_thumbnails_async([v.get("id", "") for v in videos])
        header_note = tr("Watched Video History", "Historique des vidéos vues", 'Histórico de vídeos assistidos')
    elif current_query:
        c_acc = THEME.ansi_fg("accent", bold=True)
        rst = THEME.reset
        searching = tr(
            f"Searching YouTube for “{current_query}” ({SEARCH_PAGE_SIZE} results)...",
            f"Recherche sur YouTube de “{current_query}” ({SEARCH_PAGE_SIZE} résultats)...",
            f"Buscando “{current_query}” no YouTube ({SEARCH_PAGE_SIZE} resultados)...",
        )
        sys.stderr.write(f"  {c_acc}󰗃 omayt:{rst} {searching}\r")
        sys.stderr.flush()
        videos = search_youtube(current_query, max_results=SEARCH_PAGE_SIZE)
        search_limit = SEARCH_PAGE_SIZE
        has_more = bool(videos)
        header_note = f"{tr('Search:', 'Recherche :', 'Busca:')} {current_query} • {len(videos)} {tr('videos', 'vidéos', 'vídeos')}"
    else:
        videos = load_json_file(LAST_LIST_FILE, [])
        if not videos:
            videos = load_json_file(HISTORY_FILE, [])
            header_note = tr("Recent History", "Historique récent", 'Histórico recente') if videos else ""
        else:
            state = load_json_file(STATE_FILE, {})
            current_query = (state.get("query") or "").strip()
            search_limit = int(state.get("limit") or max(SEARCH_PAGE_SIZE, len(videos)))
            has_more = bool(current_query and state.get("has_more", True))
            header_note = (
                f"{tr('Last search:', 'Dernière recherche :', 'Última busca:')} {current_query} • {len(videos)} {tr('videos', 'vidéos', 'vídeos')}"
                if current_query
                else ""
            )
        prefetch_thumbnails_async([v.get("id", "") for v in videos])

    next_load_pos: str | None = None

    while True:
        can_load_more = bool(current_query and has_more)
        rows_text = format_tui_rows(
            videos,
            header_note,
            can_load_more=can_load_more,
            page_size=SEARCH_PAGE_SIZE,
        )
        load_pos = next_load_pos or ("pos(2)" if videos else "pos(1)")
        next_load_pos = None

        if default_mode == "audio":
            enter_hint = f"Enter:󰎆 {tr('Play Cava', 'Lire Cava', 'Reproduzir Cava')}"
            mode_tag = f" • {tr('Music Mode', 'Mode musique', 'Modo música')}"
        else:
            enter_hint = f"Enter:{tr('Open/Search', 'Ouvrir/Chercher', 'Abrir/Buscar')}"
            mode_tag = ""

        more_hint = f" │ Alt-M:+{SEARCH_PAGE_SIZE}" if can_load_more else ""
        esc_hint = f" │ Esc:{tr('Menu', 'Menu', 'Menu')}" if from_menu else ""
        header_bar = (
            f"{enter_hint} │ Ctrl-S:{tr('Search', 'Chercher', 'Buscar')}{more_hint} │ "
            f"Alt-I:{tr('Terminal', 'Terminal', 'Terminal')} │ "
            f"Alt-A:󰎆 Cava │ Alt-D:{tr('Download', 'Téléch.', 'Baixar')} │ "
            f"Ctrl-H:{tr('History', 'Histo.', 'Histórico')}{esc_hint}"
        )

        label_query = (
            f" • {tr('Search:', 'Recherche :', 'Busca:')} {current_query} ({len(videos)})"
            if current_query
            else ""
        )

        fzf_cmd = [
            "fzf",
            "--ansi",
            "--disabled",
            "--print-query",
            "--layout=reverse",
            "--height=100%",
            "--border=rounded",
            f"--border-label= 󰗃 omayt • Omarchy YouTube TUI [{tr('Theme:', 'Thème :', 'Tema:')} {THEME.name}{mode_tag}{label_query}] ",
            "--border-label-pos=3",
            f"--preview-label= 󰥶 {tr('Thumbnail HD & Details', 'Vignette HD & détails', 'Miniatura HD & detalhes')} ",
            "--delimiter=\t",
            "--with-nth=2..",
            f"--prompt=  {tr('Search YouTube', 'Rechercher sur YouTube', 'Buscar no YouTube')} > ",
            f"--header={header_bar}",
            "--header-first",
            "--preview-window=right:55%:border-rounded:wrap",
            f"--preview=python3 {script} --internal-preview {{1}} {{q}}",
            f"--bind=load:{load_pos}",
            "--bind=change:first",
            "--bind=enter:print(enter)+accept",
            "--bind=ctrl-s:print(search)+accept",
            "--bind=alt-m:print(more)+accept",
            "--bind=ctrl-e:print(more)+accept",
            "--bind=ctrl-h:print(history)+accept",
            "--bind=alt-i:print(alt-i)+accept",
            "--bind=ctrl-t:print(ctrl-t)+accept",
            "--bind=alt-b:print(alt-b)+accept",
            "--bind=alt-a:print(alt-a)+accept",
            "--bind=alt-w:print(alt-w)+accept",
            "--bind=alt-d:print(alt-d)+accept",
            "--bind=alt-l:print(alt-l)+accept",
            "--bind=ctrl-f:toggle-search",
            THEME.fzf_color_arg(),
        ]

        fzf_env = dict(os.environ)
        fzf_env["SHELL"] = "/bin/sh"

        proc = subprocess.run(
            fzf_cmd,
            input=rows_text,
            stdout=subprocess.PIPE,
            text=True,
            env=fzf_env,
        )

        if proc.returncode != 0 and not proc.stdout:
            break

        out_lines = proc.stdout.splitlines()
        typed_query = out_lines[0].strip() if len(out_lines) >= 1 else ""
        action = out_lines[1].strip() if len(out_lines) >= 2 else "enter"
        selected_line = out_lines[2] if len(out_lines) >= 3 else ""

        video_id = (
            selected_line.split("\t", 1)[0].strip()
            if "\t" in selected_line
            else ""
        )

        if action == "history" or (video_id == "__HISTORY__" and not typed_query):
            videos = load_json_file(HISTORY_FILE, [])
            save_json_file(LAST_LIST_FILE, videos)
            save_json_file(STATE_FILE, {"mode": "history", "query": "", "count": len(videos), "limit": 0, "has_more": False})
            prefetch_thumbnails_async([v.get("id", "") for v in videos])
            header_note = tr("Watched Video History", "Historique des vidéos vues", 'Histórico de vídeos assistidos')
            current_query = ""
            has_more = False
            continue

        if action == "more" or video_id == "__MORE__":
            if current_query and has_more:
                old_count = len(videos)
                c_acc = THEME.ansi_fg("accent", bold=True)
                c_cyn = THEME.ansi_fg("cyan", bold=True)
                rst = THEME.reset
                os.system("clear")
                loading = tr(
                    f"Loading +{SEARCH_PAGE_SIZE} results for “{current_query}”",
                    f"Chargement de +{SEARCH_PAGE_SIZE} résultats pour “{current_query}”",
                    f"Carregando +{SEARCH_PAGE_SIZE} resultados de “{current_query}”",
                )
                print(
                    f"\n  {c_acc}󰗃 omayt:{rst} {loading}{rst} "
                    f"({old_count + 1}–{old_count + SEARCH_PAGE_SIZE})..."
                )
                videos, search_limit, added = load_more_youtube_results(
                    current_query,
                    videos,
                    search_limit,
                    page_size=SEARCH_PAGE_SIZE,
                )
                if added > 0:
                    has_more = True
                    header_note = f"{tr('Search:', 'Recherche :', 'Busca:')} {current_query} • {len(videos)} {tr('videos', 'vidéos', 'vídeos')}"
                    next_load_pos = f"pos({old_count + 2})"
                else:
                    has_more = False
                    header_note = (
                        f"{tr('Search:', 'Recherche :', 'Busca:')} {current_query} • "
                        f"{len(videos)} {tr('videos', 'vidéos', 'vídeos')} ({tr('end', 'fin', 'fim')})"
                    )
                    next_load_pos = f"pos({len(videos) + 1})" if videos else "pos(1)"
            continue

        if action == "search" or video_id in ("__SEARCH__", "__HISTORY__") or not video_id:
            q = typed_query
            if not q:
                c_acc = THEME.ansi_fg("accent", bold=True)
                c_yel = THEME.ansi_fg("yellow", bold=True)
                rst = THEME.reset
                os.system("clear")
                print(f"\n  {c_acc}󰗃 omayt • {tr('New YouTube Search', 'Nouvelle recherche YouTube', 'Nova busca no YouTube')}{rst}")
                try:
                    q = input(
                        f"  {c_yel}{tr('Type your search:', 'Saisissez votre recherche :', 'Digite sua busca:')}{rst} "
                    ).strip()
                except (EOFError, KeyboardInterrupt):
                    continue
            if q:
                c_acc = THEME.ansi_fg("accent", bold=True)
                rst = THEME.reset
                os.system("clear")
                searching = tr(
                    f"Searching YouTube for “{q}” ({SEARCH_PAGE_SIZE} results) and loading HD thumbnails...",
                    f"Recherche sur YouTube de “{q}” ({SEARCH_PAGE_SIZE} résultats) et chargement des vignettes HD...",
                    f"Buscando “{q}” no YouTube ({SEARCH_PAGE_SIZE} resultados) e carregando as miniaturas HD...",
                )
                print(f"\n  {c_acc}󰗃 omayt:{rst} {searching}")
                videos = search_youtube(q, max_results=SEARCH_PAGE_SIZE)
                current_query = q
                search_limit = SEARCH_PAGE_SIZE
                has_more = bool(videos)
                header_note = f"{tr('Search:', 'Recherche :', 'Busca:')} {q} • {len(videos)} {tr('videos', 'vidéos', 'vídeos')}"
            continue

        if action in ("alt-i", "ctrl-t"):
            play_video(video_id, mode="inline-pixels")
        elif action == "alt-b":
            play_video(video_id, mode="inline-blocks")
        elif action == "alt-a":
            play_video(video_id, mode="audio")
        elif action == "alt-w":
            play_video(video_id, mode="window")
        elif action == "alt-d":
            download_video(video_id)
        elif action == "alt-l":
            copy_link(video_id)
        else:
            play_video(video_id, mode=default_mode)

        videos = load_json_file(LAST_LIST_FILE, videos)

    return 0


