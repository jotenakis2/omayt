def _lang_code(raw: str) -> str | None:
    """Extracts a supported language code from a locale-ish string ("fr_FR.UTF-8" -> "fr")."""
    code = raw.strip().lower().replace("_", "-").split(".")[0].split("@")[0].split("-")[0]
    return code if code in UI_LANGS else None


def _env_ui_lang() -> str | None:
    return _lang_code(os.environ.get("OMAYT_LANG") or "")


def _read_settings() -> dict[str, Any]:
    try:
        data = json.loads(SETTINGS_FILE.read_text(encoding="utf-8"))
    except (OSError, ValueError):
        return {}
    return data if isinstance(data, dict) else {}


def _saved_ui_lang() -> str | None:
    lang = _read_settings().get("lang")
    return lang if lang in UI_LANGS else None


def _locale_ui_lang() -> str | None:
    for var in ("LC_ALL", "LC_MESSAGES", "LANG"):
        code = _lang_code(os.environ.get(var) or "")
        if code:
            return code
    return None


def _resolve_ui_lang() -> tuple[str, str]:
    """Returns (language, source) with source in {"env", "settings", "locale", "default"}."""
    env = _env_ui_lang()
    if env:
        return env, "env"
    saved = _saved_ui_lang()
    if saved:
        return saved, "settings"
    locale_lang = _locale_ui_lang()
    if locale_lang:
        return locale_lang, "locale"
    return "en", "default"


APP_LANG, APP_LANG_SOURCE = _resolve_ui_lang()


def tr(en: str, fr: str, pt: str) -> str:
    """Returns the string for the active UI language (English is the reference)."""
    if APP_LANG == "fr":
        return fr
    if APP_LANG == "pt":
        return pt
    return en


def save_ui_lang(code: str) -> bool:
    """Persists the language choice and applies it; False when OMAYT_LANG overrides it."""
    global APP_LANG, APP_LANG_SOURCE
    if code not in UI_LANGS:
        return False
    settings = _read_settings()
    settings["lang"] = code
    try:
        SETTINGS_FILE.parent.mkdir(parents=True, exist_ok=True)
        SETTINGS_FILE.write_text(
            json.dumps(settings, ensure_ascii=False, indent=2) + "\n", encoding="utf-8"
        )
    except OSError:
        pass
    env = _env_ui_lang()
    if env:
        APP_LANG, APP_LANG_SOURCE = env, "env"
        return False
    APP_LANG, APP_LANG_SOURCE = code, "settings"
    return True


