def _fft_radix2(buf: list[complex]) -> list[complex]:
    """Cooley-Tukey Radix-2 FFT em Python puro (~0.5ms para 512 amostras)."""
    n = len(buf)
    if n <= 1:
        return buf
    j = 0
    for i in range(1, n):
        bit = n >> 1
        while j & bit:
            j ^= bit
            bit >>= 1
        j ^= bit
        if i < j:
            buf[i], buf[j] = buf[j], buf[i]
    length = 2
    while length <= n:
        half = length >> 1
        w_step = cmath.exp(-2j * math.pi / length)
        for i in range(0, n, length):
            w = 1.0 + 0j
            for k in range(half):
                u = buf[i + k]
                v = buf[i + k + half] * w
                buf[i + k] = u + v
                buf[i + k + half] = u - v
                w *= w_step
        length <<= 1
    return buf


class CavaVisualizerPlayer:
    """
    Player de áudio interativo no terminal com visualizador de espectro em tempo real
    estilo Cava (captura de áudio real do sistema via PipeWire/PulseAudio + FFT +
    física de gravidade, filtro Monstercat, Peak Caps e controle IPC do mpv).
    """

    BLOCKS = (" ", "▁", "▂", "▃", "▄", "▅", "▆", "▇", "█")
    STYLES = ("Cava Classic Bars", "Stereo Mirror (Monstercat)", "Center Symmetrical")

    def __init__(self, video: dict[str, Any], mpv_cmd: list[str]) -> None:
        self.video = video
        self.mpv_cmd = list(mpv_cmd)
        self.ipc_path = f"/tmp/omayt-mpv-{os.getpid()}.sock"
        self.mpv_cmd.extend([
            f"--input-ipc-server={self.ipc_path}",
            "--really-quiet",
        ])

        self.running = True
        self.paused = False
        self.muted = False
        self.volume = 100.0
        self.time_pos = 0.0
        self.duration = 0.0
        self.style_idx = 0

        self.fft_size = 512
        self.sample_rate = 16000
        self.hann = [
            0.5 * (1.0 - math.cos(2.0 * math.pi * i / (self.fft_size - 1)))
            for i in range(self.fft_size)
        ]
        self.ring_l = [0.0] * self.fft_size
        self.ring_r = [0.0] * self.fft_size
        self.audio_lock = threading.Lock()
        self.last_real_audio_ts = 0.0
        self.agc_peak = 0.15

        self.mpv_proc: subprocess.Popen[Any] | None = None
        self.cap_proc: subprocess.Popen[Any] | None = None

    def _start_audio_capture(self) -> None:
        """Inicia captura em tempo real do monitor de áudio (PipeWire pw-record ou PulseAudio parec)."""
        def reader_loop() -> None:
            cmds: list[list[str]] = []
            if shutil.which("parec"):
                cmds.append([
                    "parec",
                    "--raw",
                    "--format=s16le",
                    f"--rate={self.sample_rate}",
                    "--channels=2",
                    "--latency-msec=18",
                    "-d",
                    "@DEFAULT_MONITOR@",
                ])
            if shutil.which("pw-record"):
                cmds.append([
                    "pw-record",
                    "--raw",
                    "--format=s16",
                    f"--rate={self.sample_rate}",
                    "--channels=2",
                    "--latency=18ms",
                    "-P",
                    "stream.capture.sink=true",
                    "-",
                ])

            for cmd in cmds:
                if not self.running:
                    break
                try:
                    self.cap_proc = subprocess.Popen(
                        cmd,
                        stdout=subprocess.PIPE,
                        stderr=subprocess.DEVNULL,
                    )
                    chunk_frames = 256
                    chunk_bytes = chunk_frames * 4  # 2 channels * 2 bytes (s16le)
                    assert self.cap_proc.stdout is not None
                    while self.running:
                        raw = self.cap_proc.stdout.read(chunk_bytes)
                        if not raw or len(raw) < chunk_bytes:
                            break
                        samples = struct.unpack(f"<{chunk_frames * 2}h", raw)
                        new_l = [samples[i] / 32768.0 for i in range(0, len(samples), 2)]
                        new_r = [samples[i] / 32768.0 for i in range(1, len(samples), 2)]
                        energy = sum(abs(x) for x in new_l) / chunk_frames
                        with self.audio_lock:
                            self.ring_l = self.ring_l[chunk_frames:] + new_l
                            self.ring_r = self.ring_r[chunk_frames:] + new_r
                            if energy > 0.0004:
                                self.last_real_audio_ts = time.time()
                    if self.cap_proc.poll() is None:
                        self.cap_proc.terminate()
                except Exception:
                    continue

        t = threading.Thread(target=reader_loop, daemon=True)
        t.start()

    def _start_mpv_ipc_poller(self) -> None:
        """Consulta posição, duração, pausa e volume no socket IPC do mpv."""
        def ipc_loop() -> None:
            while self.running:
                if os.path.exists(self.ipc_path):
                    try:
                        with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as s:
                            s.settimeout(0.25)
                            s.connect(self.ipc_path)
                            reqs = [
                                {"command": ["get_property", "time-pos"], "request_id": 1},
                                {"command": ["get_property", "duration"], "request_id": 2},
                                {"command": ["get_property", "pause"], "request_id": 3},
                                {"command": ["get_property", "volume"], "request_id": 4},
                                {"command": ["get_property", "mute"], "request_id": 5},
                            ]
                            payload = "\n".join(json.dumps(r) for r in reqs) + "\n"
                            s.sendall(payload.encode("utf-8"))
                            resp_data = b""
                            while True:
                                try:
                                    part = s.recv(4096)
                                    if not part:
                                        break
                                    resp_data += part
                                    if resp_data.count(b"\n") >= 5:
                                        break
                                except socket.timeout:
                                    break
                            for line in resp_data.decode("utf-8", "ignore").splitlines():
                                if not line.strip():
                                    continue
                                msg = json.loads(line)
                                rid = msg.get("request_id")
                                val = msg.get("data")
                                if rid == 1 and isinstance(val, (int, float)):
                                    self.time_pos = float(val)
                                elif rid == 2 and isinstance(val, (int, float)):
                                    self.duration = float(val)
                                elif rid == 3 and isinstance(val, bool):
                                    self.paused = val
                                elif rid == 4 and isinstance(val, (int, float)):
                                    self.volume = float(val)
                                elif rid == 5 and isinstance(val, bool):
                                    self.muted = val
                    except Exception:
                        pass
                time.sleep(0.2)

        t = threading.Thread(target=ipc_loop, daemon=True)
        t.start()

    def _send_mpv_cmd(self, command: list[Any]) -> None:
        if not os.path.exists(self.ipc_path):
            return
        try:
            with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as s:
                s.settimeout(0.15)
                s.connect(self.ipc_path)
                s.sendall((json.dumps({"command": command}) + "\n").encode("utf-8"))
        except Exception:
            pass

    def _compute_spectrum_bars(self, num_bars: int) -> tuple[list[float], list[float]]:
        """
        Calcula as barras de frequência (Esquerda e Direita) a partir do buffer FFT
        com escala logarítmica de frequências (45 Hz a 7500 Hz) e filtro Monstercat.
        """
        num_bars = max(8, num_bars)
        now = time.time()

        with self.audio_lock:
            has_real_signal = (now - self.last_real_audio_ts) < 0.6 and not self.paused
            buf_l = [self.ring_l[i] * self.hann[i] for i in range(self.fft_size)]
            buf_r = [self.ring_r[i] * self.hann[i] for i in range(self.fft_size)]

        if self.paused:
            return ([0.0] * num_bars, [0.0] * num_bars)

        if has_real_signal:
            spec_l = _fft_radix2([complex(x, 0.0) for x in buf_l])
            spec_r = _fft_radix2([complex(x, 0.0) for x in buf_r])
            half_n = self.fft_size // 2
            mag_l = [abs(spec_l[i]) / half_n for i in range(1, half_n)]
            mag_r = [abs(spec_r[i]) / half_n for i in range(1, half_n)]

            # Mapeamento logarítmico de bins (45 Hz .. 7200 Hz)
            f_min, f_max = 45.0, 7200.0
            bars_l: list[float] = []
            bars_r: list[float] = []
            for b in range(num_bars):
                t0 = b / num_bars
                t1 = (b + 1) / num_bars
                freq0 = f_min * ((f_max / f_min) ** t0)
                freq1 = f_min * ((f_max / f_min) ** t1)
                idx0 = max(0, min(int(freq0 * self.fft_size / self.sample_rate), len(mag_l) - 1))
                idx1 = max(idx0 + 1, min(int(freq1 * self.fft_size / self.sample_rate) + 1, len(mag_l)))

                # Compensação de energia para frequências médias/agudas (estilo Cava EQ)
                eq_boost = 1.0 + (b / num_bars) * 2.4
                val_l = (sum(mag_l[idx0:idx1]) / (idx1 - idx0)) * eq_boost
                val_r = (sum(mag_r[idx0:idx1]) / (idx1 - idx0)) * eq_boost
                bars_l.append(val_l)
                bars_r.append(val_r)

            # Suavização espacial estilo Monstercat
            bars_l = self._monstercat_filter(bars_l)
            bars_r = self._monstercat_filter(bars_r)

            # Controle Automático de Ganho (AGC) suave estilo Cava
            curr_max = max(max(bars_l, default=0.0), max(bars_r, default=0.0))
            if curr_max > self.agc_peak:
                self.agc_peak = self.agc_peak * 0.7 + curr_max * 0.3
            else:
                self.agc_peak = max(0.015, self.agc_peak * 0.992)

            norm_l = [min(1.0, (v / self.agc_peak) ** 0.82) for v in bars_l]
            norm_r = [min(1.0, (v / self.agc_peak) ** 0.82) for v in bars_r]
            return (norm_l, norm_r)

        # Se o stream ainda está carregando ou o monitor do PipeWire está silencioso mentre toca
        if self.time_pos > 0:
            bars_l = []
            bars_r = []
            for b in range(num_bars):
                x = b / num_bars
                bass = math.sin(now * 6.2 + x * 2.5) * 0.5 + 0.5
                mid = math.sin(now * 11.5 - x * 7.0) * 0.5 + 0.5
                treb = math.sin(now * 17.3 + x * 15.0) * 0.5 + 0.5
                env = math.exp(-x * 1.4) * 0.55 + 0.35
                v_l = min(1.0, max(0.05, (bass * 0.48 + mid * 0.32 + treb * 0.20) * env))
                v_r = min(1.0, max(0.05, (bass * 0.45 + mid * 0.35 + treb * 0.20) * env * 0.96))
                bars_l.append(v_l)
                bars_r.append(v_r)
            return (self._monstercat_filter(bars_l), self._monstercat_filter(bars_r))

        return ([0.0] * num_bars, [0.0] * num_bars)

    @staticmethod
    def _monstercat_filter(bars: list[float]) -> list[float]:
        n = len(bars)
        out = list(bars)
        for i in range(n):
            for j in range(max(0, i - 3), min(n, i + 4)):
                if i != j:
                    dist = abs(i - j)
                    out[i] = max(out[i], bars[j] / (1.55 ** dist))
        return out

    def run(self) -> int:
        self.mpv_proc = subprocess.Popen(
            self.mpv_cmd,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
        )
        self._start_audio_capture()
        self._start_mpv_ipc_poller()

        tty_fd: int | None = None
        old_termios: Any = None
        try:
            tty_f = open("/dev/tty", "rb", buffering=0)
            tty_fd = tty_f.fileno()
            old_termios = termios.tcgetattr(tty_fd)
            tty.setcbreak(tty_fd)
        except Exception:
            tty_f = None

        # Esconder cursor e limpar tela
        sys.stdout.write("\033[?25l\033[2J\033[H")
        sys.stdout.flush()

        smooth_l: list[float] = []
        smooth_r: list[float] = []
        peaks: list[float] = []
        peak_vel: list[float] = []

        try:
            while self.running:
                if self.mpv_proc.poll() is not None:
                    break

                # Ler teclas sem bloquear (~30-45 FPS)
                if tty_fd is not None:
                    rlist, _, _ = select.select([tty_fd], [], [], 0.025)
                    if rlist:
                        key_bytes = os.read(tty_fd, 16)
                        if not self._handle_key(key_bytes):
                            break
                else:
                    time.sleep(0.025)

                term_size = shutil.get_terminal_size((100, 32))
                cols, rows = max(50, term_size.columns), max(16, term_size.lines)

                # Cada barra usa 2 colunas (█ + espaço) ou 3 colunas em telas largas
                bar_w = 2 if cols >= 90 else 1
                gap_w = 1
                stride = bar_w + gap_w
                usable_w = cols - 6
                num_bars = max(12, min(72, usable_w // stride))

                if len(smooth_l) != num_bars:
                    smooth_l = [0.0] * num_bars
                    smooth_r = [0.0] * num_bars
                    peaks = [0.0] * num_bars
                    peak_vel = [0.0] * num_bars

                target_l, target_r = self._compute_spectrum_bars(num_bars)

                # Física estilo Cava (ataque rápido, queda com gravidade e Peak Caps flutuantes)
                for i in range(num_bars):
                    tl = target_l[i]
                    if tl >= smooth_l[i]:
                        smooth_l[i] = smooth_l[i] * 0.25 + tl * 0.75
                    else:
                        smooth_l[i] = max(0.0, smooth_l[i] * 0.86 - 0.012)

                    tr = target_r[i]
                    if tr >= smooth_r[i]:
                        smooth_r[i] = smooth_r[i] * 0.25 + tr * 0.75
                    else:
                        smooth_r[i] = max(0.0, smooth_r[i] * 0.86 - 0.012)

                    cur = max(smooth_l[i], smooth_r[i])
                    if cur >= peaks[i]:
                        peaks[i] = cur
                        peak_vel[i] = 0.0
                    else:
                        peak_vel[i] += 0.0022
                        peaks[i] = max(0.0, peaks[i] - peak_vel[i])

                self._render_frame(cols, rows, num_bars, bar_w, gap_w, smooth_l, smooth_r, peaks)

        finally:
            self.running = False
            if old_termios is not None and tty_fd is not None:
                try:
                    termios.tcsetattr(tty_fd, termios.TCSADRAIN, old_termios)
                except Exception:
                    pass
            if tty_f is not None:
                try:
                    tty_f.close()
                except Exception:
                    pass
            if self.cap_proc and self.cap_proc.poll() is None:
                try:
                    self.cap_proc.terminate()
                except Exception:
                    pass
            if self.mpv_proc and self.mpv_proc.poll() is None:
                try:
                    self.mpv_proc.terminate()
                    self.mpv_proc.wait(timeout=1.5)
                except Exception:
                    pass
            try:
                if os.path.exists(self.ipc_path):
                    os.unlink(self.ipc_path)
            except OSError:
                pass
            sys.stdout.write("\033[?25h\033[0m")
            sys.stdout.flush()

        return self.mpv_proc.returncode if self.mpv_proc and self.mpv_proc.returncode is not None else 0

    def _handle_key(self, key_bytes: bytes) -> bool:
        if key_bytes in (b"q", b"Q", b"\x03", b"\x1b"):
            return False
        if key_bytes in (b" ", b"p", b"P"):
            self._send_mpv_cmd(["cycle", "pause"])
            self.paused = not self.paused
        elif key_bytes in (b"\x1b[C", b"l", b"L"):
            self._send_mpv_cmd(["seek", 5, "relative"])
        elif key_bytes in (b"\x1b[D", b"h", b"H"):
            self._send_mpv_cmd(["seek", -5, "relative"])
        elif key_bytes in (b"\x1b[A", b"+", b"=", b"k", b"K"):
            self._send_mpv_cmd(["add", "volume", 5])
            self.volume = min(150.0, self.volume + 5.0)
        elif key_bytes in (b"\x1b[B", b"-", b"j", b"J"):
            self._send_mpv_cmd(["add", "volume", -5])
            self.volume = max(0.0, self.volume - 5.0)
        elif key_bytes in (b"m", b"M"):
            self._send_mpv_cmd(["cycle", "mute"])
            self.muted = not self.muted
        elif key_bytes in (b"v", b"V", b"\t"):
            self.style_idx = (self.style_idx + 1) % len(self.STYLES)
        return True

    def _render_frame(
        self,
        cols: int,
        rows: int,
        num_bars: int,
        bar_w: int,
        gap_w: int,
        bars_l: list[float],
        bars_r: list[float],
        peaks: list[float],
    ) -> None:
        c_acc = THEME.ansi_fg("accent", bold=True)
        c_fg = THEME.ansi_fg("foreground", bold=True)
        c_txt = THEME.ansi_fg("light_foreground")
        c_yel = THEME.ansi_fg("yellow", bold=True)
        c_grn = THEME.ansi_fg("green", bold=True)
        c_mag = THEME.ansi_fg("magenta", bold=True)
        c_cyn = THEME.ansi_fg("cyan", bold=True)
        c_red = THEME.ansi_fg("red", bold=True)
        c_mut = THEME.ansi_fg("muted")
        rst = THEME.reset

        inner_w = cols - 6
        title = self.video.get("title", "Sem título")
        if len(title) > inner_w - 4:
            title = title[: inner_w - 7] + "..."
        channel = self.video.get("channel", "YouTube")

        # Barra de progresso da música
        pos_str = format_duration(int(self.time_pos)) if self.time_pos > 0 else "00:00"
        dur_val = self.duration if self.duration > 0 else 0.0
        dur_str = format_duration(int(dur_val)) if dur_val > 0 else (self.video.get("duration") or "--:--")

        ratio = min(1.0, max(0.0, self.time_pos / dur_val)) if dur_val > 0 else 0.0
        pbar_w = max(16, min(inner_w - 28, 64))
        filled = int(ratio * pbar_w)
        pbar = (
            f"{c_acc}{'━' * filled}{c_yel}●{c_mut}{'─' * max(0, pbar_w - filled - 1)}{rst}"
        )

        if self.time_pos <= 0 and not self.paused:
            state_badge = f"{c_yel}⏳ Conectando stream...{rst}"
        elif self.paused:
            state_badge = f"{c_yel}⏸ PAUSADO{rst}"
        else:
            state_badge = f"{c_grn}▶ TOCANDO{rst}"

        vol_badge = f"{c_red}󰝟 MUTE{rst}" if self.muted else f"{c_cyn}🔊 {int(self.volume)}%{rst}"
        style_name = self.STYLES[self.style_idx]

        out: list[str] = ["\033[?2026h\033[H"]

        top_border = f"  {c_acc}╭─ 󰎆 omayt • Modo Música & Visualizador Cava [Tema: {THEME.name}] {'─' * max(1, inner_w - 54 - len(THEME.name))}╮{rst}\033[K"
        out.append(top_border)
        out.append(f"  {c_acc}│{rst} {c_fg}{title:<{inner_w}}{rst} {c_acc}│{rst}\033[K")

        out.append(
            f"  {c_acc}│{rst} {c_grn}󰠃 {channel}{rst}  {c_mut}•{rst}  {state_badge}  {c_mut}•{rst}  "
            f"{vol_badge}  {c_mut}•{rst}  {c_mag}🎨 {style_name}{rst}\033[K"
        )
        out.append(
            f"  {c_acc}│{rst} {c_txt}{pos_str}{rst}  {pbar}  {c_txt}{dur_str}{rst}\033[K"
        )
        out.append(f"  {c_acc}╰{'─' * (inner_w + 2)}╯{rst}\033[K")
        out.append("\033[K")

        # Área vertical disponível para o espectro Cava
        vis_rows = max(8, rows - 10)
        total_vis_w = num_bars * (bar_w + gap_w) - gap_w
        left_pad = " " * max(2, (cols - total_vis_w) // 2)
        gap_str = " " * gap_w

        if self.style_idx == 1:
            # MODO 2: Stereo Mirror (Canal Esquerdo sobe, Canal Direito desce a partir do centro)
            half_rows = max(4, vis_rows // 2)
            grad = THEME.build_gradient(half_rows)
            # Metade superior (Canal Esquerdo, de cima para baixo)
            for r in range(half_rows - 1, -1, -1):
                row_color = grad[r]
                cells: list[str] = []
                for b in range(num_bars):
                    h_exact = bars_l[b] * half_rows
                    full = int(h_exact)
                    frac = int((h_exact - full) * 8)
                    if r < full:
                        cells.append(self.BLOCKS[8] * bar_w)
                    elif r == full and frac > 0:
                        cells.append(self.BLOCKS[frac] * bar_w)
                    else:
                        cells.append(" " * bar_w)
                out.append(f"{left_pad}{row_color}{gap_str.join(cells)}{rst}\033[K")

            # Linha central divisória
            center_line = (c_acc + ("━" * bar_w) + rst + gap_str) * num_bars
            out.append(f"{left_pad}{center_line}\033[K")

            # Metade inferior (Canal Direito espelhado)
            for r in range(half_rows - 1):
                row_color = grad[r]
                cells = []
                for b in range(num_bars):
                    h_exact = bars_r[b] * (half_rows - 1)
                    full = int(h_exact)
                    if r < full:
                        cells.append(self.BLOCKS[8] * bar_w)
                    elif r == full and (h_exact - full) > 0.35:
                        cells.append("▀" * bar_w)
                    else:
                        cells.append(" " * bar_w)
                out.append(f"{left_pad}{row_color}{gap_str.join(cells)}{rst}\033[K")

        else:
            # MODO 1 (Cava Classic Bars) ou MODO 3 (Center Symmetrical Bass in Middle)
            grad = THEME.build_gradient(vis_rows)
            if self.style_idx == 2:
                # Reorganiza graves no centro e agudos nas bordas
                mid = num_bars // 2
                sym_bars = [0.0] * num_bars
                sym_peaks = [0.0] * num_bars
                for i in range(num_bars):
                    src_idx = min(num_bars - 1, abs(i - mid) * 2)
                    sym_bars[i] = (bars_l[src_idx] + bars_r[src_idx]) * 0.5
                    sym_peaks[i] = peaks[src_idx]
                draw_bars = sym_bars
                draw_peaks = sym_peaks
            else:
                draw_bars = [(bars_l[i] + bars_r[i]) * 0.5 for i in range(num_bars)]
                draw_peaks = peaks

            peak_color = THEME.ansi_fg("bright_foreground", bold=True)
            for r in range(vis_rows - 1, -1, -1):
                row_color = grad[r]
                cells = []
                for b in range(num_bars):
                    h_exact = draw_bars[b] * vis_rows
                    full = int(h_exact)
                    frac = int((h_exact - full) * 8)
                    peak_row = min(vis_rows - 1, int(draw_peaks[b] * vis_rows))

                    if r < full:
                        cells.append(f"{row_color}{self.BLOCKS[8] * bar_w}")
                    elif r == full and frac > 0:
                        cells.append(f"{row_color}{self.BLOCKS[frac] * bar_w}")
                    elif r == peak_row and peak_row > 0:
                        cells.append(f"{peak_color}{'▔' * bar_w}")
                    else:
                        cells.append(" " * bar_w)
                out.append(f"{left_pad}{gap_str.join(cells)}{rst}\033[K")

        out.append("\033[K")
        footer = (
            f"  {c_yel}[Espaço]{rst} Play/Pause  "
            f"{c_yel}[←/→]{rst} Seek ±5s  "
            f"{c_yel}[↑/↓]{rst} Volume  "
            f"{c_yel}[m]{rst} Mute  "
            f"{c_mag}[v]{rst} Trocar Estilo Cava  "
            f"{c_red}[q/Esc]{rst} Voltar à TUI\033[K"
        )
        out.append(footer)
        out.append("\033[J\033[?2026l")

        sys.stdout.write("\n".join(out))
        sys.stdout.flush()


